<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("../components/header.ejs") %>

    <style>
        html,
        body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
        }

        body#page-top {
            min-height: 100vh;
            overflow: hidden;
            position: relative;
        }

        /* Background Image */
        .bg-layer {
            position: fixed;
            inset: 0;
            background: url("/images/5l.jpg") center center / cover no-repeat;
            z-index: -2;
            transition: .3s ease;
        }

        /* Dark Overlay */
        body.dark .bg-layer::after {
            content: "";
            position: absolute;
            inset: 0;
            background: rgba(0, 0, 0, .55);
        }

        /* Login Page Container */
        .page-container {
            width: 100%;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }
    </style>
</head>

<body id="page-top">

    <!-- Background -->
    <div class="bg-layer"></div>

    <!-- Login Content -->
    <div class="page-container">
        <%- include(body) %>
    </div>

    <!-- Global Scripts -->
    <%- include("../scripts/main-script.ejs") %>

    <!-- Page Script -->
    <% if (typeof pageScript !== "undefined") { %>
        <%- include(pageScript) %>
    <% } %>

</body>

</html>