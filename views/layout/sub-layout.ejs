
<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("../components/header.ejs") %>

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <style>
        html,
        body {
            margin: 0;
            padding: 0;
            width: 100%;
            min-height: 100%;
        }

        body#page-top {
            min-height: 100vh;
            position: relative;
            overflow: hidden;
            background-color: #222;
        }

        /* Background */
        .bg-layer {
            position: fixed;
            inset: 0;
            z-index: 0;
            pointer-events: none;

            background-image: url("/images/login-light.jpg");
            background-position: center;
            background-size: cover;
            background-repeat: no-repeat;
        }

        /* Dark background */
        html.dark .bg-layer {
            background-image: url("/images/login-dark.jpg");
        }

        /* Dark overlay */
        .bg-layer::after {
            content: "";
            position: absolute;
            inset: 0;
            background: transparent;
            transition: background 0.3s ease;
        }

        html.dark .bg-layer::after {
            background: rgba(0, 0, 0, 0.55);
        }

        /* Page content */
        .page-container {
            position: relative;
            z-index: 1;
            width: 100%;
            min-height: 100vh;

            display: flex;
            justify-content: center;
            align-items: center;
        }
    </style>
</head>

<body id="page-top">

    <div class="bg-layer"></div>

    <div class="page-container">
        <%- include(body) %>
    </div>

    <!-- Global scripts -->
    <%- include("../scripts/main-script.ejs") %>

    <!-- Page scripts -->
    <% if (typeof pageScript !== "undefined" && pageScript) { %>
        <%- include(pageScript) %>
    <% } %>

</body>
</html>
