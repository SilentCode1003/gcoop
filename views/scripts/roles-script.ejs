<script>
$(document).ready(function () {

    let rolesById = {};

    // ==========================
    // DATE FORMATTER
    // ==========================
    function formatDate(date) {
        if (!date) return "";
        return new Date(date).toLocaleString();
    }

    // ==========================
    // ESCAPE HTML
    // ==========================
    const esc = (v) =>
        String(v ?? "").replace(
            /[&<>"']/g,
            (c) =>
                ({
                    "&": "&amp;",
                    "<": "&lt;",
                    ">": "&gt;",
                    '"': "&quot;",
                    "'": "&#39;",
                })[c],
        );

    // ==========================
    // TOAST
    // ==========================
    const Toast = Swal.mixin({
        toast: true,
        position: "top-end",
        showConfirmButton: false,
        timer: 2500,
        timerProgressBar: true,
    });

    const errorMessage = (err, fallback) =>
        err?.responseJSON?.message || fallback;

    // ==========================
    // LOAD ROLES
    // ==========================
    async function loadRoles() {

        const roles = await queryUtility.Load("/roles/load-role");

        const $tbody = $("#roleTable").empty();

        rolesById = {};

        for (const role of roles) {

            rolesById[role.id] = role;

            $tbody.append(`
                <tr>
                    <td>${esc(role.id)}</td>
                    <td>${esc(role.name)}</td>
                    <td>${esc(formatDate(role.createdDate))}</td>
                    <td>${esc(formatDate(role.updatedDate))}</td>

                    <td>
                        <div class="d-flex justify-content-center align-items-center">
                            <button
                                type="button"
                                class="btn btn-secondary btn-sm btn-edit mr-2"
                                data-id="${esc(role.id)}">
                                <i class="fas fa-edit"></i>
                            </button>

                            <button
                                type="button"
                                class="btn btn-danger btn-sm btn-delete"
                                data-id="${esc(role.id)}">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            `);

        }

    }

    // ==========================
    // OPEN MODAL
    // ==========================
    function openModal(role) {

        const isEdit = !!role;

        $("#roleForm")[0].reset();
        $("#roleForm .form-control").removeClass("is-invalid");

        $("#roleId").val(isEdit ? role.id : "");

        $("#modalTitle").html(
            isEdit
                ? '<i class="fas fa-user-edit mr-2"></i>Edit Role'
                : '<i class="fas fa-user-tag mr-2"></i>Add Role'
        );

        if (isEdit) {
            $("#roleName").val(role.name);
        }

        $("#roleModal").modal("show");

    }

    // ==========================
    // GET FORM DATA
    // ==========================
    function getFormData() {

        return {
            Name: $("#roleName").val().trim(),
        };

    }

    // ==========================
    // VALIDATE
    // ==========================
    function validate(data) {

        const checks = {
            "#roleName": !!data.Name,
        };

        let valid = true;

        for (const [selector, ok] of Object.entries(checks)) {
            $(selector).toggleClass("is-invalid", !ok);
            if (!ok) valid = false;
        }

        return valid;

    }

    // ==========================
    // ADD BUTTON
    // ==========================
    $("#btnAdd").on("click", () => openModal(null));

    // ==========================
    // EDIT BUTTON
    // ==========================
    $("#roleTable").on("click", ".btn-edit", function () {

        const role = rolesById[$(this).data("id")];

        if (role) openModal(role);

    });

    // ==========================
    // SAVE
    // ==========================
    $("#roleForm").on("submit", async function (e) {

        e.preventDefault();

        const id = $("#roleId").val();
        const isEdit = id !== "";

        const payload = getFormData();

        if (!validate(payload)) return;

        const confirm = await Swal.fire({
            title: isEdit ? "Save changes?" : "Add this Role?",
            text: isEdit
                ? `Update "${payload.Name}"?`
                : `Add "${payload.Name}" to the role list?`,
            icon: "question",
            showCancelButton: true,
            confirmButtonText: isEdit ? "Yes, save" : "Yes, add",
            cancelButtonText: "Cancel",
            confirmButtonColor: "#991b1b",
            cancelButtonColor: "#6c757d",
        });

        if (!confirm.isConfirmed) return;

        Swal.fire({
            title: "Saving...",
            allowOutsideClick: false,
            didOpen: () => Swal.showLoading(),
        });

        try {

            if (isEdit) {

                await queryUtility.Update(
                    `/roles/update-role/${encodeURIComponent(id)}`,
                    payload
                );

            } else {

                await queryUtility.Save(
                    "/roles/create-role",
                    payload
                );

            }

            $("#roleModal").modal("hide");

            await loadRoles();

            Swal.close();

            Toast.fire({
                icon: "success",
                title: isEdit
                    ? "Role updated successfully"
                    : "Role added successfully",
            });

        } catch (err) {

            Swal.fire({
                icon: "error",
                title: isEdit ? "Update failed" : "Create failed",
                text: errorMessage(err, "Something went wrong. Please try again."),
                confirmButtonColor: "#991b1b",
            });

        }

    });

    // ==========================
    // DELETE
    // ==========================
    $("#roleTable").on("click", ".btn-delete", async function () {

        const id = $(this).data("id");

        const role = rolesById[id];

        if (!role) return;

        const confirm = await Swal.fire({
            title: "Delete this role?",
            text: `"${role.name}" will be permanently removed.`,
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Yes, delete",
            cancelButtonText: "Cancel",
            confirmButtonColor: "#dc3545",
            cancelButtonColor: "#6c757d",
        });

        if (!confirm.isConfirmed) return;

        try {

            await queryUtility.Delete(
                `/roles/delete-role/${encodeURIComponent(id)}`
            );

            await loadRoles();

            Toast.fire({
                icon: "success",
                title: "Role deleted successfully",
            });

        } catch (err) {

            Swal.fire({
                icon: "error",
                title: "Delete failed",
                text: errorMessage(err, "Something went wrong. Please try again."),
                confirmButtonColor: "#991b1b",
            });

        }

    });

    // ==========================
    // INITIAL LOAD
    // ==========================
    loadRoles();

});
</script>