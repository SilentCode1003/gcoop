<script>
$(function () {

    // Load dashboard on page load
    loadDashboard();

    // Refresh Dashboard
    $("#btnRefresh").on("click", async function () {

        const $btn = $(this);
        const isDark = $("body").hasClass("dark");

        $btn.prop("disabled", true);

        Swal.fire({
            title: "Refreshing...",
            text: "Please wait...",
            allowOutsideClick: false,
            allowEscapeKey: false,
            showConfirmButton: false,
            background: isDark ? "#1f1f1f" : "#ffffff",
            color: isDark ? "#ffffff" : "#222222",
            didOpen: () => {
                Swal.showLoading();
            }
        });

        try {

            await loadDashboard();

            Swal.close();

            Swal.fire({
                toast: true,
                position: "top-end",
                icon: "success",
                title: "Dashboard Updated",
                timer: 1500,
                showConfirmButton: false,
                background: $("body").hasClass("dark") ? "#1f1f1f" : "#ffffff",
                color: $("body").hasClass("dark") ? "#ffffff" : "#222222"
            });

        } catch (error) {

            console.error(error);

            Swal.fire({
                icon: "error",
                title: "Refresh Failed",
                text: "Unable to refresh the dashboard.",
                background: $("body").hasClass("dark") ? "#1f1f1f" : "#ffffff",
                color: $("body").hasClass("dark") ? "#ffffff" : "#222222"
            });

        } finally {

            $btn.prop("disabled", false);

        }

    });

});

// ==========================
// LOAD DASHBOARD
// ==========================

async function loadDashboard() {

    try {

        const dashboard = await queryUtility.Load("/dashboard/load");

        $("#totalMembers").text(dashboard.totalMembers || 0);
        $("#totalUsers").text(dashboard.totalUsers || 0);
        $("#totalLoanRates").text(dashboard.totalLoanRates || 0);
        $("#totalDenomination").text(dashboard.totalDenomination || 0);

        $("#recentMembers").empty();

        if (dashboard.members && dashboard.members.length > 0) {

            dashboard.members.forEach(member => {

                $("#recentMembers").append(`
                    <tr>
                        <td>${member.employeeid}</td>
                        <td>${member.fullname}</td>
                        <td>${member.contact}</td>
                        <td>${member.registerdate}</td>
                    </tr>
                `);

            });

        } else {

            $("#recentMembers").html(`
                <tr>
                    <td colspan="4" class="text-center text-muted">
                        No members found.
                    </td>
                </tr>
            `);

        }

        return dashboard;

    } catch (error) {

        console.error(error);
        throw error;

    }

}
</script>