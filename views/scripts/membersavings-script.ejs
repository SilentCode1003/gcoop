<script>
  $(document).ready(function () {
    let savingsById = {};

    const Toast = Swal.mixin({
      toast: true,
      position: "top-end",
      showConfirmButton: false,
      timer: 2500,
      timerProgressBar: true,
    });

    function errorMessage(error, fallback) {
      return (
        error?.responseJSON?.message ||
        error?.responseJSON?.error ||
        error?.message ||
        fallback
      );
    }

    function esc(value) {
      return String(value ?? "").replace(/[&<>"']/g, function (character) {
        return {
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#39;",
        }[character];
      });
    }

    /* ms_id is a UUID string */
    function isValidUUID(value) {
      return /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(
        String(value || "").trim(),
      );
    }

    /* ms_member_id is an INT */
    function isValidMemberId(value) {
      return /^\d+$/.test(String(value || "")) && Number(value) > 0;
    }

    function formatAmount(value) {
      return Number(value || 0).toLocaleString("en-PH", {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      });
    }

    function formatDate(value) {
      if (!value) return "—";

      const date = new Date(value);

      if (Number.isNaN(date.getTime())) return "—";

      return (
        date.toLocaleDateString("en-PH", {
          year: "numeric",
          month: "short",
          day: "2-digit",
        }) +
        " " +
        date.toLocaleTimeString("en-PH", {
          hour: "2-digit",
          minute: "2-digit",
        })
      );
    }

    function showTableMessage(message, className = "") {
      $("#savingsTable").html(`
        <tr>
          <td colspan="6" class="text-center ${className}">
            ${esc(message)}
          </td>
        </tr>
      `);
    }

    /*
     * Members who already have a savings account are hidden,
     * except the member of the record being edited.
     */
    async function loadMembers(selectedId = "") {
      const data = await queryUtility.Load("/member-savings/load-members");

      const $select = $("#MemberID");

      $select.empty().append(`<option value="">Select Member</option>`);

      if (!Array.isArray(data)) return;

      data.forEach(function (item) {
        const memberId = String(item.id ?? "").trim();

        if (!memberId) return;

        if (item.hasSavings && memberId !== String(selectedId)) return;

        $select.append(
          `<option value="${esc(memberId)}">${esc(item.name || "Member")} (#${esc(memberId)})</option>`,
        );
      });

      if (selectedId) {
        $select.val(String(selectedId));
      }
    }

    async function loadSavings() {
      try {
        showTableMessage("Loading member savings...", "text-muted");

        const data = await queryUtility.Load("/member-savings/load-savings");

        $("#savingsTable").empty();
        savingsById = {};

        if (!Array.isArray(data) || data.length === 0) {
          showTableMessage("No member savings records found.", "text-muted");
          return;
        }

        data.forEach(function (item) {
          const savingsId = String(item.id || "").trim();

          if (!savingsId) return;

          savingsById[savingsId] = item;

          const hasTransactions = Number(item.transactionCount) > 0;

          $("#savingsTable").append(`
            <tr>
              <td>${esc(item.memberId)}</td>
              <td>${esc(item.memberName || "—")}</td>
              <td>₱${formatAmount(item.balance)}</td>
              <td>${esc(item.transactionCount)}</td>
              <td>${esc(formatDate(item.updatedAt))}</td>

              <td class="text-center">
                <button
                  type="button"
                  class="btn btn-secondary btn-sm btn-edit"
                  data-id="${esc(savingsId)}"
                  title="Edit"
                >
                  <i class="fas fa-edit"></i>
                </button>

                <button
                  type="button"
                  class="btn btn-danger btn-sm ml-2 btn-delete"
                  data-id="${esc(savingsId)}"
                  title="${hasTransactions ? "Has ledger transactions" : "Delete"}"
                  ${hasTransactions ? "disabled" : ""}
                >
                  <i class="fas fa-trash"></i>
                </button>
              </td>
            </tr>
          `);
        });
      } catch (error) {
        console.error("Load member savings error:", error);

        showTableMessage(
          errorMessage(error, "Unable to load member savings."),
          "text-danger",
        );
      }
    }

    async function openModal(data = null) {
      const form = $("#savingsForm")[0];

      if (!form) return;

      form.reset();
      $("#savingsForm .form-control").removeClass("is-invalid");
      $("#SavingsRecordID").val("");
      $("#MemberID").prop("disabled", false);
      $("#Balance").prop("disabled", false).val("0");

      try {
        await loadMembers(data ? String(data.memberId ?? "") : "");
      } catch (error) {
        console.error("Load members error:", error);

        Swal.fire({
          icon: "error",
          title: "Error",
          text: errorMessage(error, "Unable to load members."),
        });

        return;
      }

      if (data) {
        const savingsId = String(data.id || "").trim();

        if (!isValidUUID(savingsId)) {
          Swal.fire({
            icon: "error",
            title: "Invalid Savings ID",
            text: "The selected record does not contain a valid UUID.",
          });

          return;
        }

        const locked = Number(data.transactionCount) > 0;

        $("#savingsModalLabel").html(`
          <i class="fas fa-edit mr-2"></i>
          Edit Savings Account
        `);

        $("#SavingsRecordID").val(savingsId);
        $("#MemberID").val(String(data.memberId ?? ""));
        $("#Balance").val(data.balance ?? "0");

        $("#BalanceLabel").html(
          `Current Balance <span class="text-danger">*</span>`,
        );

        if (locked) {
          // Balance can only change through the Savings Ledger,
          // but the member can still be corrected.
          $("#Balance").prop("disabled", true);

          $("#BalanceHint").text(
            "This account has ledger transactions, so the balance can only be changed in the Savings Ledger. You can still reassign the account to another member (its transactions move with it).",
          );
        } else {
          $("#BalanceHint").text(
            "No ledger transactions yet, so the member and balance can still be corrected.",
          );
        }

        $("#btnSave")
          .html(`<i class="fas fa-save mr-1"></i> Update Account`)
          .prop("disabled", false);
      } else {
        $("#savingsModalLabel").html(`
          <i class="fas fa-plus mr-2"></i>
          New Savings Account
        `);

        $("#BalanceLabel").html(
          `Opening Balance <span class="text-danger">*</span>`,
        );

        $("#BalanceHint").text(
          "An opening balance above zero is also recorded as a deposit in the Savings Ledger.",
        );

        $("#btnSave")
          .html(`<i class="fas fa-save mr-1"></i> Save Account`)
          .prop("disabled", false);
      }

      $("#savingsModal").modal("show");
    }

    function getFormData() {
      return {
        memberId: String($("#MemberID").val() || "").trim(),
        balance: String($("#Balance").val() || "").trim(),
      };
    }

    function validate(data) {
      let valid = true;

      $("#savingsForm .form-control").removeClass("is-invalid");

      if (!isValidMemberId(data.memberId)) {
        $("#MemberID").addClass("is-invalid");
        valid = false;
      }

      const balanceIsValid =
        /^\d+(\.\d{1,2})?$/.test(data.balance) && Number(data.balance) >= 0;

      if (!balanceIsValid) {
        $("#Balance").addClass("is-invalid");
        valid = false;
      }

      return valid;
    }

    // ==========================
    // EVENTS
    // ==========================

    $(document).on("click", "#btnAdd", function () {
      openModal(null);
    });

    $("#savingsTable").on("click", ".btn-edit", function () {
      const savingsId = String($(this).attr("data-id") || "").trim();

      if (!isValidUUID(savingsId)) {
        Swal.fire({
          icon: "error",
          title: "Update Failed",
          text: "Invalid Savings ID.",
        });

        return;
      }

      const record = savingsById[savingsId];

      if (!record) {
        Swal.fire({
          icon: "error",
          title: "Update Failed",
          text: "Savings record was not found.",
        });

        return;
      }

      openModal(record);
    });

    $("#savingsForm").on("submit", async function (event) {
      event.preventDefault();

      const savingsId = String($("#SavingsRecordID").val() || "").trim();
      const isEdit = savingsId !== "";
      const payload = getFormData();

      if (isEdit && !isValidUUID(savingsId)) {
        Swal.fire({
          icon: "error",
          title: "Update Failed",
          text: "Invalid Savings ID.",
        });

        return;
      }

      if (!validate(payload)) return;

      const confirmation = await Swal.fire({
        title: isEdit ? "Update Savings Account?" : "Create Savings Account?",
        text: isEdit
          ? "Are you sure you want to update this savings account?"
          : "Are you sure you want to create this savings account?",
        icon: "question",
        showCancelButton: true,
        confirmButtonText: isEdit ? "Yes, update" : "Yes, create",
        cancelButtonText: "Cancel",
        confirmButtonColor: "#4e73df",
        cancelButtonColor: "#858796",
      });

      if (!confirmation.isConfirmed) return;

      Swal.fire({
        title: isEdit ? "Updating..." : "Creating...",
        allowOutsideClick: false,
        didOpen: function () {
          Swal.showLoading();
        },
      });

      try {
        if (isEdit) {
          await queryUtility.Update(
            "/member-savings/update-savings/" + encodeURIComponent(savingsId),
            payload,
          );
        } else {
          await queryUtility.Save("/member-savings/create-savings", payload);
        }

        $("#savingsModal").modal("hide");

        await loadSavings();

        Swal.close();

        Toast.fire({
          icon: "success",
          title: isEdit
            ? "Savings account updated successfully."
            : "Savings account created successfully.",
        });
      } catch (error) {
        console.error("Create/update savings error:", error);

        Swal.fire({
          icon: "error",
          title: isEdit ? "Update Failed" : "Create Failed",
          text: errorMessage(error, "Something went wrong. Please try again."),
        });
      }
    });

    $("#savingsTable").on("click", ".btn-delete", async function () {
      const savingsId = String($(this).attr("data-id") || "").trim();

      if (!isValidUUID(savingsId)) {
        Swal.fire({
          icon: "error",
          title: "Delete Failed",
          text: "Invalid Savings ID.",
        });

        return;
      }

      const confirmation = await Swal.fire({
        title: "Delete Savings Account?",
        text: "This action cannot be undone.",
        icon: "warning",
        showCancelButton: true,
        confirmButtonText: "Yes, delete",
        cancelButtonText: "Cancel",
        confirmButtonColor: "#d33",
      });

      if (!confirmation.isConfirmed) return;

      try {
        await queryUtility.Delete(
          "/member-savings/delete-savings/" + encodeURIComponent(savingsId),
        );

        await loadSavings();

        Toast.fire({
          icon: "success",
          title: "Savings account deleted successfully.",
        });
      } catch (error) {
        console.error("Delete savings error:", error);

        Swal.fire({
          icon: "error",
          title: "Delete Failed",
          text: errorMessage(error, "Unable to delete savings account."),
        });
      }
    });

    loadSavings();
  });
</script>
