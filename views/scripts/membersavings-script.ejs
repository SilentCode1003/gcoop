<script>
  $(document).ready(function () {
    const SIGN = {
      DEPOSIT: 1,
      INTEREST_PAYOUT: 1,
      ADJUSTMENT: 1,
      TRANSFER: 1,
      WITHDRAWAL: -1,
      PENALTY: -1,
    };

    let savings = [];
    let byMember = {};
    let searchTimer = null;

    let historyRows = [];
    let historyRequest = 0;

    const Toast = Swal.mixin({
      toast: true,
      position: "top-end",
      showConfirmButton: false,
      timer: 2500,
      timerProgressBar: true,
    });

    const errorMessage = (error, fallback) =>
      error?.responseJSON?.message ||
      error?.responseJSON?.error ||
      error?.message ||
      fallback;

    const esc = (value) =>
      String(value ?? "").replace(
        /[&<>"']/g,
        (c) =>
          ({
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#39;",
          })[c],
      );

    const round2 = (n) => Math.round(Number(n) * 100) / 100;

    function formatAmount(value) {
      return Number(value || 0).toLocaleString("en-PH", {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      });
    }

    function formatType(value) {
      return String(value || "")
        .toLowerCase()
        .replace(/_/g, " ")
        .replace(/\b\w/g, (c) => c.toUpperCase());
    }

    function formatDate(value) {
      if (!value) return "—";

      const date = new Date(value);

      if (Number.isNaN(date.getTime())) return "—";

      return (
        date.toLocaleDateString("en-PH", {
          year: "numeric",
          month: "short",
          day: "2-digit",
        }) +
        " " +
        date.toLocaleTimeString("en-PH", {
          hour: "2-digit",
          minute: "2-digit",
        })
      );
    }

    function showTableMessage(message, className = "") {
      $("#savingsTable").html(`
        <tr>
          <td colspan="7" class="text-center ${className}">${esc(message)}</td>
        </tr>
      `);
    }

    // ==========================
    // RENDER
    // ==========================

    function render() {
      const term = String($("#msSearch").val() || "")
        .trim()
        .toLowerCase();

      const list = savings.filter(function (item) {
        if (!term) return true;

        return (
          String(item.memberName || "")
            .toLowerCase()
            .includes(term) ||
          String(item.employeeId || "")
            .toLowerCase()
            .includes(term) ||
          String(item.memberId).includes(term)
        );
      });

      if (!list.length) {
        showTableMessage(
          savings.length
            ? "No members match your search."
            : "No members found.",
          "text-muted",
        );
        return;
      }

      const $tbody = $("#savingsTable").empty();

      list.forEach(function (item) {
        $tbody.append(`
          <tr>
            <td>${esc(item.memberId)}</td>
            <td>${esc(item.employeeId || "—")}</td>
            <td>${esc(item.memberName || "—")}</td>
            <td class="text-right font-weight-bold">₱${formatAmount(item.balance)}</td>
            <td class="text-center">${esc(item.transactionCount)}</td>
            <td>${esc(formatDate(item.updatedAt))}</td>
            <td class="text-center">
              <button
                type="button"
                class="btn btn-add btn-sm btn-icon btn-transact"
                data-id="${esc(item.memberId)}"
                title="New transaction"
                aria-label="New transaction"
              >
                <i class="fas fa-exchange-alt"></i>
              </button>

              <button
                type="button"
                class="btn btn-sm btn-icon btn-history ml-1"
                data-id="${esc(item.memberId)}"
                title="Transaction history"
                aria-label="Transaction history"
              >
                <i class="fas fa-history"></i>
              </button>
            </td>
          </tr>
        `);
      });
    }

    async function loadSavings() {
      try {
        showTableMessage("Loading member savings...", "text-muted");

        const data = await queryUtility.Load("/member-savings/load-savings");

        savings = Array.isArray(data) ? data : [];
        byMember = {};

        savings.forEach(function (item) {
          byMember[String(item.memberId)] = item;
        });

        render();
      } catch (error) {
        console.error("Load member savings error:", error);

        showTableMessage(
          errorMessage(error, "Unable to load member savings."),
          "text-danger",
        );
      }
    }

    // ==========================
    // TRANSACTION MODAL
    // ==========================

    function updatePreview() {
      const member = byMember[String($("#MemberID").val())];
      const type = String($("#TransactionType").val() || "");
      const amount = Number($("#Amount").val());

      const $preview = $("#balancePreview");

      if (!member || !SIGN[type] || !Number.isFinite(amount) || amount <= 0) {
        $preview.empty();
        return;
      }

      const after = round2(Number(member.balance) + SIGN[type] * amount);

      $preview.html(
        after < 0
          ? `<span class="text-danger"><i class="fas fa-exclamation-triangle mr-1"></i>Insufficient balance — this would leave −₱${formatAmount(Math.abs(after))}.</span>`
          : `<span class="text-muted">Balance after this transaction:</span> <strong>₱${formatAmount(after)}</strong>`,
      );
    }

    function openModal(memberId) {
      const member = byMember[String(memberId)];

      if (!member) return;

      $("#transactForm")[0].reset();
      $("#transactForm .form-control").removeClass("is-invalid");
      $("#balancePreview").empty();

      $("#MemberID").val(member.memberId);
      $("#MemberName").val(
        `${member.memberName || "Member"} (#${member.memberId})`,
      );
      $("#CurrentBalance").val("₱" + formatAmount(member.balance));

      $("#transactModal").modal("show");
    }

    function validate(data) {
      let valid = true;

      $("#transactForm .form-control").removeClass("is-invalid");

      if (!SIGN[data.transactionType]) {
        $("#TransactionType").addClass("is-invalid");
        valid = false;
      }

      const amountIsValid =
        /^\d+(\.\d{1,2})?$/.test(data.amount) && Number(data.amount) > 0;

      if (!amountIsValid) {
        $("#Amount").addClass("is-invalid");
        valid = false;
      }

      if (data.description.length > 1000) {
        $("#Description").addClass("is-invalid");
        valid = false;
      }

      return valid;
    }

    // ==========================
    // HISTORY MODAL
    // ==========================

    function showHistoryMessage(message, className = "") {
      $("#historyTable").html(`
        <tr>
          <td colspan="6" class="text-center ${className}">${esc(message)}</td>
        </tr>
      `);
    }

    function renderHistory() {
      const filter = String($("#historyFilter").val() || "");

      const list = filter
        ? historyRows.filter((row) => row.type === filter)
        : historyRows;

      $("#historyCount").text(
        filter
          ? `Showing ${list.length} of ${historyRows.length} transactions`
          : `${historyRows.length} transaction${historyRows.length === 1 ? "" : "s"}`,
      );

      if (!list.length) {
        showHistoryMessage(
          historyRows.length
            ? "No transactions match this filter."
            : "No transactions yet.",
          "text-muted",
        );
        return;
      }

      const $tbody = $("#historyTable").empty();

      list.forEach(function (row) {
        const sign = SIGN[row.type] || 1;
        const isCredit = sign > 0;

        $tbody.append(`
          <tr>
            <td class="text-nowrap">${esc(formatDate(row.createdAt))}</td>
            <td class="text-nowrap">${esc(row.referenceNo || "—")}</td>
            <td>
              <span class="ms-badge ${isCredit ? "ms-badge-credit" : "ms-badge-debit"}">
                ${esc(formatType(row.type))}
              </span>
            </td>
            <td class="text-right text-nowrap ${isCredit ? "amount-credit" : "amount-debit"}">
              ${isCredit ? "+" : "−"}₱${formatAmount(row.amount)}
            </td>
            <td class="text-right text-nowrap">₱${formatAmount(row.balanceAfter)}</td>
            <td>${esc(row.description || "—")}</td>
          </tr>
        `);
      });
    }

    function renderHistorySummary() {
      let totalIn = 0;
      let totalOut = 0;

      historyRows.forEach(function (row) {
        const amount = Number(row.amount || 0);

        if ((SIGN[row.type] || 1) > 0) totalIn += amount;
        else totalOut += amount;
      });

      $("#historyTotalIn").text("₱" + formatAmount(totalIn));
      $("#historyTotalOut").text("₱" + formatAmount(totalOut));
    }

    async function openHistory(memberId) {
      const member = byMember[String(memberId)];

      if (!member) return;

      const requestId = ++historyRequest;

      historyRows = [];

      $("#historyFilter").val("");
      $("#historyMemberName").text(
        `${member.memberName || "Member"} (#${member.memberId})`,
      );
      $("#historyBalance").text("₱" + formatAmount(member.balance));
      $("#historyTotalIn").text("₱0.00");
      $("#historyTotalOut").text("₱0.00");
      $("#historyCount").text("");

      showHistoryMessage("Loading transactions...", "text-muted");

      $("#historyModal").modal("show");

      try {
        const data = await queryUtility.Load(
          "/member-savings/history/" + encodeURIComponent(member.memberId),
        );

        // Ignore stale responses if another member was opened meanwhile
        if (requestId !== historyRequest) return;

        historyRows = Array.isArray(data) ? data : [];

        renderHistorySummary();
        renderHistory();
      } catch (error) {
        if (requestId !== historyRequest) return;

        console.error("Load history error:", error);

        showHistoryMessage(
          errorMessage(error, "Unable to load transaction history."),
          "text-danger",
        );
      }
    }

    // ==========================
    // EVENTS
    // ==========================

    $("#msSearch").on("input", function () {
      clearTimeout(searchTimer);
      searchTimer = setTimeout(render, 200);
    });

    $("#savingsTable").on("click", ".btn-transact", function () {
      openModal($(this).attr("data-id"));
    });

    $("#savingsTable").on("click", ".btn-history", function () {
      openHistory($(this).attr("data-id"));
    });

    $("#historyFilter").on("change", renderHistory);

    $("#TransactionType, #Amount").on("input change", updatePreview);

    $("#transactForm").on("submit", async function (event) {
      event.preventDefault();

      const member = byMember[String($("#MemberID").val())];

      if (!member) return;

      const payload = {
        memberId: String(member.memberId),
        transactionType: String($("#TransactionType").val() || "").trim(),
        amount: String($("#Amount").val() || "").trim(),
        description: String($("#Description").val() || "").trim(),
      };

      if (!validate(payload)) return;

      const after = round2(
        Number(member.balance) +
          SIGN[payload.transactionType] * Number(payload.amount),
      );

      if (after < 0) {
        $("#Amount").addClass("is-invalid");

        Swal.fire({
          icon: "error",
          title: "Insufficient balance",
          text: `Current balance is ₱${formatAmount(member.balance)}.`,
        });

        return;
      }

      const confirmation = await Swal.fire({
        title: "Record this transaction?",
        html: `${esc(formatType(payload.transactionType))} of <b>₱${formatAmount(payload.amount)}</b> for <b>${esc(member.memberName || "this member")}</b>.<br>New balance: <b>₱${formatAmount(after)}</b>`,
        icon: "question",
        showCancelButton: true,
        confirmButtonText: "Yes, record it",
        cancelButtonText: "Cancel",
        confirmButtonColor: "#991b1b",
        cancelButtonColor: "#6c757d",
      });

      if (!confirmation.isConfirmed) return;

      Swal.fire({
        title: "Saving...",
        allowOutsideClick: false,
        didOpen: () => Swal.showLoading(),
      });

      try {
        const response = await queryUtility.Save(
          "/member-savings/transact",
          payload,
        );

        $("#transactModal").modal("hide");

        await loadSavings();

        Swal.close();

        const reference = response?.data?.referenceNo;

        Toast.fire({
          icon: "success",
          title: reference
            ? `Transaction recorded (${reference})`
            : "Transaction recorded.",
        });
      } catch (error) {
        console.error("Transact error:", error);

        Swal.fire({
          icon: "error",
          title: "Transaction failed",
          text: errorMessage(error, "Something went wrong. Please try again."),
          confirmButtonColor: "#991b1b",
        });
      }
    });

    loadSavings();
  });
</script>
