<script>
    async function loadLedger() {
    const ledger = await queryUtility.Load("/savings-ledger/load-ledger");

    $("#ledgerTable").empty();

    ledgerById = {};

    ledger.forEach((row) => {

        ledgerById[row.id] = row;

        $("#ledgerTable").append(`
            <tr>

                <td>${esc(row.referenceNo)}</td>

                <td>${esc(row.member)}</td>

                <td>${esc(row.transactionType)}</td>

                <td class="text-right">
                    ₱ ${Number(row.amount || 0).toLocaleString("en-PH", {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    })}
                </td>

                <td class="text-right">
                    ₱ ${Number(row.balanceAfter || 0).toLocaleString("en-PH", {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    })}
                </td>

                <td>${esc(row.description || "")}</td>

                <td>${esc(row.createdBy || "")}</td>

                <td>${formatDate(row.createdDate)}</td>

                <td class="text-center">

                    <button
                        type="button"
                        class="btn btn-secondary btn-sm btn-edit"
                        data-id="${row.id}">
                        <i class="fas fa-edit"></i>
                    </button>

                    <button
                        type="button"
                        class="btn btn-danger btn-sm ml-2 btn-delete"
                        data-id="${row.id}">
                        <i class="fas fa-trash"></i>
                    </button>

                </td>

            </tr>
        `);

    });

}
</script>