<script>
$(document).ready(function () {
    let membersById = {};

    const Toast = Swal.mixin({
        toast: true,
        position: "top-end",
        showConfirmButton: false,
        timer: 2500,
        timerProgressBar: true
    });

    function esc(v) {
        return String(v ?? "").replace(/[&<>"']/g, function (c) {
            return {
                "&": "&amp;",
                "<": "&lt;",
                ">": "&gt;",
                '"': "&quot;",
                "'": "&#39;"
            }[c];
        });
    }

    // ===========================
    // LOAD MEMBERS
    // ===========================
    async function loadMembers() {
        try {
            const members = await queryUtility.Load("/members/load");

            const $tbody = $("#memberTable").empty();
            membersById = {};

            $.each(members, function (i, m) {
                membersById[m.id] = m;

                $tbody.append(`
                    <tr>
                        <td>${esc(m.employeeId)}</td>
                        <td>${esc(m.fullName)}</td>
                        <td>${esc(m.address)}</td>
                        <td>${esc(m.contact)}</td>
                        <td>${esc(m.registeredDate)}</td>
                        <td>${esc(m.registeredBy)}</td>
                        <td>
                            <button type="button"
                                class="btn btn-secondary btn-sm mb-1 btn-edit"
                                data-id="${esc(m.id)}">
                                <i class="fas fa-edit"></i> Edit
                            </button>
                            <button type="button"
                                class="btn btn-danger btn-sm btn-delete"
                                data-id="${esc(m.id)}">
                                <i class="fas fa-trash"></i> Delete
                            </button>
                        </td>
                    </tr>
                `);
            });
        } catch (err) {
            console.error(err);
            Swal.fire("Error", "Unable to load members.", "error");
        }
    }

    // ===========================
    // OPEN MODAL (ADD / EDIT)
    // ===========================
    function openModal(member = null) {
        $("#memberForm")[0].reset();
        $("#memberId").val("");

        if (member) {
            $("#memberId").val(member.id);
            $("#employeeId").val(member.employeeId);
            $("#fullName").val(member.fullName);
            $("#address").val(member.address);
            $("#contact").val(member.contact);
            $("#registeredBy").val(member.registeredBy);
            $("#modalTitle").text("Edit Member");
        } else {
            $("#modalTitle").text("Add Member");
        }

        $("#memberModal").modal("show");
    }
    // ================= GET FORM =================
    // ================= GET FORM DATA =================
function getFormData() {
    return {
        EmployeeId: $("#employeeId").val().trim(),
        FullName: $("#fullName").val().trim(),
        Address: $("#address").val().trim(),
        Contact: $("#contact").val().trim(),
        RegisteredBy: $("#registeredBy").val().trim()
    };
}

    // ================= VALIDATE =================
   function validate(data) {

    let valid = true;

    $("#employeeId").toggleClass("is-invalid", !data.EmployeeId);
    $("#fullName").toggleClass("is-invalid", !data.FullName);
    $("#address").toggleClass("is-invalid", !data.Address);
    $("#contact").toggleClass("is-invalid", !data.Contact);
    $("#registeredBy").toggleClass("is-invalid", !data.RegisteredBy);

    if (!data.EmployeeId) valid = false;
    if (!data.FullName) valid = false;
    if (!data.Address) valid = false;
    if (!data.Contact) valid = false;
    if (!data.RegisteredBy) valid = false;

    return valid;
}


    // ===========================
    // EVENT HANDLERS
    // ===========================
    $("#btnAdd").on("click", function () {
        openModal(null);
    });

    $("#memberTable").on("click", ".btn-edit", function () {
        const member = membersById[$(this).data("id")];
        if (member) openModal(member);
    });

    $("#memberTable").on("click", ".btn-delete", async function () {
        const id = $(this).data("id");

        const result = await Swal.fire({
            title: "Delete Member?",
            text: "This action cannot be undone.",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Delete"
        });

        if (!result.isConfirmed) return;

        try {
            await queryUtility.Delete("/members/delete/" + id);

            Toast.fire({ icon: "success", title: "Member deleted." });
            loadMembers();
        } catch (err) {
            console.error(err);
            Swal.fire("Error", "Unable to delete member.", "error");
        }
    });

    // ===========================
    // SAVE
    // ===========================
    $("#memberForm").submit(async function (e) {

    e.preventDefault();

    const body = getFormData();

    if (!validate(body)) {
        return;
    }

    const id = $("#memberId").val();

    try {

        if (id === "") {
            await queryUtility.Save("/members/create", body);
        } else {
            await queryUtility.Update("/members/update/" + id, body);
        }

        $("#memberModal").modal("hide");
        loadMembers();

    } catch (err) {
        Swal.fire("Error", "Something went wrong.", "error");
    }

});

    // ===========================
    // INIT
    // ===========================
    loadMembers();
});
</script>