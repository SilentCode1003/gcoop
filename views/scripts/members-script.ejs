<script>
  $(document).ready(function () {
    let membersById = {};

    // ==========================
    // DATE FORMATTER
    // ==========================
    function formatDate(date) {
      if (!date) return "";
      return new Date(date).toLocaleString();
    }

    // ==========================
    // ESCAPE HTML
    // ==========================
    const esc = (v) =>
      String(v ?? "").replace(
        /[&<>"']/g,
        (c) =>
          ({
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#39;",
          })[c],
      );

    // ==========================
    // TOAST
    // ==========================
    const Toast = Swal.mixin({
      toast: true,
      position: "top-end",
      showConfirmButton: false,
      timer: 2500,
      timerProgressBar: true,
    });

    const errorMessage = (err, fallback) =>
      err?.responseJSON?.message || fallback;

    // ==========================
    // LOAD MEMBERS
    // ==========================
    async function loadMembers() {
      const members = await queryUtility.Load("/members/load-member");

      const $tbody = $("#memberTable").empty();

      membersById = {};

      for (const m of members) {
        membersById[m.id] = m;

        $tbody.append(`
                <tr>
                    <td>${esc(m.employeeId)}</td>
                    <td>${esc(m.fullName)}</td>
                    <td>${esc(m.address)}</td>
                    <td>${esc(m.contact)}</td>
                    <td>${esc(formatDate(m.registeredDate))}</td>
                    <td>${esc(m.registeredBy)}</td>

                    <td>
                        <button
                            type="button"
                            class="btn btn-secondary btn-sm btn-edit"
                            data-id="${esc(m.id)}">
                            <i class="fas fa-edit"></i>
                        </button>

                        <button
                            type="button"
                            class="btn btn-danger btn-sm ml-2 btn-delete"
                            data-id="${esc(m.id)}">
                            <i class="fas fa-trash"></i>
                        </button>
                    </td>
                </tr>
            `);
      }
    }

    // ==========================
    // OPEN MODAL
    // ==========================
    function openModal(member) {
      const isEdit = !!member;

      $("#memberForm")[0].reset();
      $("#memberForm .form-control").removeClass("is-invalid");

      $("#memberId").val(isEdit ? member.id : "");

      $("#modalTitle").html(
        isEdit
          ? '<i class="fas fa-user-edit mr-2"></i>Edit Member'
          : '<i class="fas fa-user-plus mr-2"></i>Add Member',
      );

      if (isEdit) {
        $("#employeeId").val(member.employeeId);
        $("#fullName").val(member.fullName);
        $("#address").val(member.address);
        $("#contact").val(member.contact);
      }

      $("#memberModal").modal("show");
    }

    // ==========================
    // GET FORM DATA
    // ==========================
    function getFormData() {
      return {
        EmployeeId: $("#employeeId").val().trim(),
        FullName: $("#fullName").val().trim(),
        Address: $("#address").val().trim(),
        Contact: $("#contact").val().trim(),
      };
    }

    // ==========================
    // VALIDATE
    // ==========================
    function validate(data) {
      const checks = {
        "#employeeId": !!data.EmployeeId,
        "#fullName": !!data.FullName,
        "#address": !!data.Address,
        "#contact": !!data.Contact,
      };

      let valid = true;

      for (const [selector, ok] of Object.entries(checks)) {
        $(selector).toggleClass("is-invalid", !ok);
        if (!ok) valid = false;
      }

      return valid;
    }

    // ==========================
    // ADD BUTTON
    // ==========================
    $("#btnAdd").on("click", () => openModal(null));

    // ==========================
    // EDIT BUTTON
    // ==========================
    $("#memberTable").on("click", ".btn-edit", function () {
      const member = membersById[$(this).data("id")];

      if (member) openModal(member);
    });

    // ==========================
    // SAVE
    // ==========================
    $("#memberForm").on("submit", async function (e) {
      e.preventDefault();

      const id = $("#memberId").val();
      const isEdit = id !== "";

      const payload = getFormData();

      if (!validate(payload)) return;

      const confirm = await Swal.fire({
        title: isEdit ? "Save changes?" : "Add this Member?",
        text: isEdit
          ? `Update ${payload.FullName}'s record?`
          : `Add ${payload.FullName} to the members list?`,
        icon: "question",
        showCancelButton: true,
        confirmButtonText: isEdit ? "Yes, save" : "Yes, add",
        cancelButtonText: "Cancel",
        confirmButtonColor: "#991b1b",
        cancelButtonColor: "#6c757d",
      });

      if (!confirm.isConfirmed) return;

      Swal.fire({
        title: "Saving...",
        allowOutsideClick: false,
        didOpen: () => Swal.showLoading(),
      });

      try {
        if (isEdit) {
          await queryUtility.Update(
            `/members/update-member/${encodeURIComponent(id)}`,
            payload,
          );
        } else {
          await queryUtility.Save("/members/create-member", payload);
        }

        $("#memberModal").modal("hide");

        await loadMembers();

        Swal.close();

        Toast.fire({
          icon: "success",
          title: isEdit
            ? "Member updated successfully"
            : "Member added successfully",
        });
      } catch (err) {
        Swal.fire({
          icon: "error",
          title: isEdit ? "Update failed" : "Create failed",
          text: errorMessage(err, "Something went wrong. Please try again."),
          confirmButtonColor: "#991b1b",
        });
      }
    });

    // ==========================
    // DELETE
    // ==========================
    $("#memberTable").on("click", ".btn-delete", async function () {
      const id = $(this).data("id");

      const member = membersById[id];

      if (!member) return;

      const confirm = await Swal.fire({
        title: "Delete this member?",
        text: `${member.fullName} will be permanently removed.`,
        icon: "warning",
        showCancelButton: true,
        confirmButtonText: "Yes, delete",
        cancelButtonText: "Cancel",
        confirmButtonColor: "#dc3545",
        cancelButtonColor: "#6c757d",
      });

      if (!confirm.isConfirmed) return;

      try {
        await queryUtility.Delete(
          `/members/delete-member/${encodeURIComponent(id)}`,
        );

        await loadMembers();

        Toast.fire({
          icon: "success",
          title: "Member deleted successfully",
        });
      } catch (err) {
        Swal.fire({
          icon: "error",
          title: "Delete failed",
          text: errorMessage(err, "Something went wrong. Please try again."),
          confirmButtonColor: "#991b1b",
        });
      }
    });

    // ==========================
    // INITIAL LOAD
    // ==========================
    loadMembers();
  });
</script>
