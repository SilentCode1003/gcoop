<script>
  $(document).ready(function () {
    let ledgerById = {};

    // ==========================
    // HELPERS
    // ==========================

    const formatDate = (date) => {
      if (!date) return "";
      return new Date(date).toLocaleString();
    };

    const esc = (v) =>
      String(v ?? "").replace(
        /[&<>"']/g,
        (c) =>
          ({
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#39;",
          })[c],
      );

    const Toast = Swal.mixin({
      toast: true,
      position: "top-end",
      timer: 2500,
      showConfirmButton: false,
      timerProgressBar: true,
    });

    const errorMessage = (err, fallback) =>
      err?.responseJSON?.message || err.message || fallback;

    // ==========================
    // LOAD MEMBERS
    // ==========================

    async function loadSavings(selected = "") {
      const savings = await queryUtility.Load("/savings-ledger/load-member");

      const $select = $("#SavingsID").empty();

      $select.append('<option value="">Select Member</option>');

      savings.forEach((s) => {
        $select.append(`
                <option value="${s.id}">
                    ${esc(s.member)}
                </option>
            `);
      });

      $select.val(selected);
    }

    // ==========================
    // LOAD TRANSACTION TYPES
    // ==========================

    function loadTransactionTypes(selected = "") {
      $("#TransactionType").html(`
            <option value="">Select Transaction</option>
            <option value="DEPOSIT">Deposit</option>
            <option value="WITHDRAWAL">Withdrawal</option>
            <option value="INTEREST_PAYOUT">Interest Payout</option>
            <option value="PENALTY">Penalty</option>
            <option value="ADJUSTMENT">Adjustment</option>
            <option value="TRANSFER">Transfer</option>
        `);

      $("#TransactionType").val(selected);
    }

    // ==========================
    // LOAD LEDGER
    // ==========================

    async function loadLedger() {
      try {
        const data = await queryUtility.Load("/savings-ledger/load-ledger");

        ledgerById = {};

        const $tbody = $("#ledgerTable");
        $tbody.empty();

        data.forEach((row) => {
          ledgerById[row.id] = row;

          $tbody.append(`
                <tr>

                    <td>${esc(row.referenceNo)}</td>

                    <td>${esc(row.member)}</td>

                    <td>${esc(row.transactionType)}</td>

                    <td class="text-right">
                        ₱ ${Number(row.amount || 0).toLocaleString("en-PH", {
                          minimumFractionDigits: 2,
                          maximumFractionDigits: 2,
                        })}
                    </td>

                    <td class="text-right">
                        ₱ ${Number(row.balanceAfter || 0).toLocaleString(
                          "en-PH",
                          {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2,
                          },
                        )}
                    </td>

                    <td>${esc(row.description || "")}</td>

                    <td>${esc(row.createdBy || "")}</td>

                    <td>${esc(formatDate(row.createdDate))}</td>

                    <td class="action-buttons">

                        <button
                            type="button"
                            class="btn btn-secondary btn-sm btn-edit"
                            data-id="${row.id}">
                            <i class="fas fa-edit"></i>
                        </button>

                        <button
                            type="button"
                            class="btn btn-danger btn-sm ml-2 btn-delete"
                            data-id="${row.id}">
                            <i class="fas fa-trash"></i>
                        </button>

                    </td>

                </tr>
            `);
        });
      } catch (err) {
        Swal.fire(
          "Error",
          errorMessage(err, "Unable to load savings ledger."),
          "error",
        );
      }
    }

    // ---------- MODAL ----------

    async function openModal(ledger) {
      const isEdit = !!ledger;

      $("#ledgerForm")[0].reset();
      $("#ledgerForm .form-control").removeClass("is-invalid");

      $("#LedgerID").val(isEdit ? ledger.id : "");

      await loadSavings(isEdit ? ledger.savingsId : "");
      loadTransactionTypes(isEdit ? ledger.transactionType : "");

      $("#ledgerModalLabel").html(
        isEdit
          ? '<i class="fas fa-edit mr-2"></i>Edit Transaction'
          : '<i class="fas fa-plus-circle mr-2"></i>New Transaction',
      );

      if (isEdit) {
        $("#Amount").val(ledger.amount);
        $("#Description").val(ledger.description);
      }

      $("#ledgerModal").modal("show");
    }
    // ==========================
    // VALIDATION
    // ==========================

    function getFormData() {
      return {
        SavingsID: $("#SavingsID").val(),
        TransactionType: $("#TransactionType").val(),
        Amount: $("#Amount").val(),
        Description: $("#Description").val().trim(),
      };
    }

    function validate(p) {
      let valid = true;

      $("#SavingsID").toggleClass("is-invalid", !p.SavingsID);
      $("#TransactionType").toggleClass("is-invalid", !p.TransactionType);
      $("#Amount").toggleClass("is-invalid", Number(p.Amount) <= 0);

      if (!p.SavingsID) valid = false;
      if (!p.TransactionType) valid = false;
      if (Number(p.Amount) <= 0) valid = false;

      return valid;
    }

    // ==========================
// ADD
// ==========================

$(document)
    .off("click", "#btnAdd")
    .on("click", "#btnAdd", async function (e) {

        e.preventDefault();

        try {

            await openModal(null);

        } catch (err) {

            console.error(err);

            Swal.fire({
                icon: "error",
                title: "Unable to open form",
                text: errorMessage(
                    err,
                    "Unable to load members. Make sure member exists."
                ),
                confirmButtonColor: "#991b1b",
            });

        }

    });
    // ==========================
    // EDIT
    // ==========================

    $("#ledgerTable").on("click", ".btn-edit", function () {
      const ledger = ledgerById[$(this).data("id")];
      if (ledger) openModal(ledger);
    });
    // ==========================
    // SAVE
    // ==========================

    $("#ledgerForm").on("submit", async function (e) {
      e.preventDefault();

      const id = $("#LedgerID").val();
      const isEdit = id !== "";

      const payload = getFormData();

      if (!validate(payload)) return;

      const result = await Swal.fire({
        title: isEdit ? "Save Changes?" : "Add Transaction?",
        text: isEdit
          ? "Do you want to save the changes?"
          : "Do you want to add this transaction?",
        icon: "question",
        showCancelButton: true,
        confirmButtonText: isEdit ? "Save" : "Add",
        cancelButtonText: "Cancel",
        confirmButtonColor: "#991b1b",
        cancelButtonColor: "#6c757d",
        reverseButtons: true,
      });

      if (!result.isConfirmed) return;

      Swal.fire({
        title: "Please wait...",
        text: "Saving transaction...",
        allowOutsideClick: false,
        allowEscapeKey: false,
        didOpen: () => Swal.showLoading(),
      });

      try {
        if (isEdit) {
          await queryUtility.Update(
            `/savings-ledger/update-ledger/${id}`,
            payload,
          );
        } else {
          await queryUtility.Save("/savings-ledger/create-ledger", payload);
        }

        $("#ledgerModal").modal("hide");

        await loadLedger();

        Swal.fire({
          icon: "success",
          title: "Success",
          text: isEdit
            ? "Transaction updated successfully."
            : "Transaction added successfully.",
          timer: 1800,
          showConfirmButton: false,
        });
      } catch (err) {
        Swal.fire({
          icon: "error",
          title: "Error",
          text: errorMessage(err, "Unable to save transaction."),
        });
      }
    });

    // ==========================
    // DELETE
    // ==========================

    $("#ledgerTable").on("click", ".btn-delete", async function () {
      const id = $(this).data("id");
      const ledger = ledgerById[id];

      if (!ledger) return;

      const result = await Swal.fire({
        title: "Delete Transaction?",
        text: `Reference No. ${ledger.referenceNo}`,
        icon: "warning",
        showCancelButton: true,
        confirmButtonText: "Delete",
        cancelButtonText: "Cancel",
        confirmButtonColor: "#dc3545",
        cancelButtonColor: "#6c757d",
        reverseButtons: true,
      });

      if (!result.isConfirmed) return;

      Swal.fire({
        title: "Deleting...",
        allowOutsideClick: false,
        allowEscapeKey: false,
        didOpen: () => Swal.showLoading(),
      });

      try {
        await queryUtility.Delete(`/savings-ledger/delete-ledger/${id}`);

        await loadLedger();

        Swal.fire({
          icon: "success",
          title: "Deleted",
          text: "Transaction deleted successfully.",
          timer: 1800,
          showConfirmButton: false,
        });
      } catch (err) {
        Swal.fire({
          icon: "error",
          title: "Error",
          text: errorMessage(err, "Unable to delete transaction."),
        });
      }
    });
    // ==========================
    // INIT
    // ==========================

    loadSavings();
    loadTransactionTypes();
    loadLedger();
  });
</script>
