<script>
  $(document).ready(function () {
    let ledgerById = {};

    const Toast = Swal.mixin({
      toast: true,
      position: "top-end",
      showConfirmButton: false,
      timer: 2500,
      timerProgressBar: true,
    });

    function errorMessage(error, fallback) {
      return (
        error?.responseJSON?.message ||
        error?.responseJSON?.error ||
        error?.message ||
        fallback
      );
    }

    function esc(value) {
      return String(value ?? "").replace(/[&<>"']/g, function (character) {
        return {
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#39;",
        }[character];
      });
    }

    /* sl_id is a UUID string */
    function isValidUUID(value) {
      return /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(
        String(value || "").trim(),
      );
    }

    /* sl_savings_id is an INT (member_savings.ms_member_id) */
    function isValidSavingsId(value) {
      return /^\d+$/.test(String(value || "")) && Number(value) > 0;
    }

    function formatAmount(value) {
      return Number(value || 0).toLocaleString("en-PH", {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      });
    }

    function formatType(value) {
      return String(value || "")
        .toLowerCase()
        .replace(/_/g, " ")
        .replace(/\b\w/g, function (c) {
          return c.toUpperCase();
        });
    }

    function formatDate(value) {
      if (!value) return "—";

      const date = new Date(value);

      if (Number.isNaN(date.getTime())) return "—";

      return (
        date.toLocaleDateString("en-PH", {
          year: "numeric",
          month: "short",
          day: "2-digit",
        }) +
        " " +
        date.toLocaleTimeString("en-PH", {
          hour: "2-digit",
          minute: "2-digit",
        })
      );
    }

    function showTableMessage(message, className = "") {
      $("#ledgerTable").html(`
        <tr>
          <td colspan="9" class="text-center ${className}">
            ${esc(message)}
          </td>
        </tr>
      `);
    }

    async function loadSavingsIds(selectedId = "") {
      const data = await queryUtility.Load("/savings-ledger/load-member");

      const $select = $("#SavingsID");

      $select.empty().append(`<option value="">Select Member Savings</option>`);

      if (!Array.isArray(data)) return;

      data.forEach(function (item) {
        const memberId = String(item.id ?? "").trim();

        if (!memberId) return;

        $select.append(
          `<option value="${esc(memberId)}">Member #${esc(memberId)} — Balance ₱${formatAmount(item.balance)}</option>`,
        );
      });

      if (selectedId) {
        $select.val(String(selectedId));
      }
    }

    async function loadLedger() {
      try {
        showTableMessage("Loading savings ledger...", "text-muted");

        const data = await queryUtility.Load("/savings-ledger/load-ledger");

        $("#ledgerTable").empty();
        ledgerById = {};

        if (!Array.isArray(data) || data.length === 0) {
          showTableMessage("No savings ledger records found.", "text-muted");
          return;
        }

        data.forEach(function (item) {
          const ledgerId = String(item.id || "").trim();

          if (!ledgerId) return;

          ledgerById[ledgerId] = item;

          $("#ledgerTable").append(`
            <tr>
              <td>${esc(item.referenceNo)}</td>
              <td>${esc(item.savingsId)}</td>
              <td>${esc(formatType(item.transactionType))}</td>
              <td>₱${formatAmount(item.amount)}</td>
              <td>₱${formatAmount(item.balanceAfter)}</td>
              <td>${esc(item.description || "")}</td>
              <td>${esc(item.createdBy || "")}</td>
              <td>${esc(formatDate(item.createdDate))}</td>

              <td class="text-center">
                <button
                  type="button"
                  class="btn btn-secondary btn-sm btn-edit"
                  data-id="${esc(ledgerId)}"
                  title="Edit"
                >
                  <i class="fas fa-edit"></i>
                </button>

                <button
                  type="button"
                  class="btn btn-danger btn-sm ml-2 btn-delete"
                  data-id="${esc(ledgerId)}"
                  title="Delete"
                >
                  <i class="fas fa-trash"></i>
                </button>
              </td>
            </tr>
          `);
        });
      } catch (error) {
        console.error("Load ledger error:", error);

        showTableMessage(
          errorMessage(error, "Unable to load savings ledger."),
          "text-danger",
        );
      }
    }

    async function openModal(data = null) {
      const form = $("#ledgerForm")[0];

      if (!form) return;

      form.reset();
      $("#ledgerForm .form-control").removeClass("is-invalid");
      $("#LedgerID").val("");
      $("#autoFields").hide();
      $("#SavingsID").prop("disabled", false);

      try {
        await loadSavingsIds(data ? String(data.savingsId ?? "") : "");
      } catch (error) {
        console.error("Load savings IDs error:", error);

        Swal.fire({
          icon: "error",
          title: "Error",
          text: errorMessage(error, "Unable to load savings accounts."),
        });

        return;
      }

      if (data) {
        const ledgerId = String(data.id || "").trim();

        if (!isValidUUID(ledgerId)) {
          Swal.fire({
            icon: "error",
            title: "Invalid Ledger ID",
            text: "The selected ledger record does not contain a valid UUID.",
          });

          return;
        }

        $("#ledgerModalLabel").html(`
          <i class="fas fa-edit mr-2"></i>
          Edit Savings Transaction
        `);

        $("#LedgerID").val(ledgerId);
        $("#SavingsID").val(String(data.savingsId ?? ""));
        $("#SavingsID").prop("disabled", true); // member can't change on edit
        $("#TransactionType").val(data.transactionType || "");
        $("#Amount").val(data.amount ?? "");
        $("#Description").val(data.description || "");

        $("#ReferenceNo").val(data.referenceNo || "");
        $("#BalanceAfter").val("₱" + formatAmount(data.balanceAfter));
        $("#autoFields").show();

        $("#btnSave").html(`
          <i class="fas fa-save mr-1"></i>
          Update Transaction
        `);
      } else {
        $("#ledgerModalLabel").html(`
          <i class="fas fa-plus mr-2"></i>
          New Transaction
        `);

        $("#btnSave").html(`
          <i class="fas fa-save mr-1"></i>
          Save Transaction
        `);
      }

      $("#ledgerModal").modal("show");
    }

    function getFormData() {
      return {
        savingsId: String($("#SavingsID").val() || "").trim(),
        transactionType: String($("#TransactionType").val() || "").trim(),
        amount: String($("#Amount").val() || "").trim(),
        description: String($("#Description").val() || "").trim(),
      };
    }

    function validate(data) {
      let valid = true;

      $("#ledgerForm .form-control").removeClass("is-invalid");

      if (!isValidSavingsId(data.savingsId)) {
        $("#SavingsID").addClass("is-invalid");
        valid = false;
      }

      const allowedTypes = [
        "DEPOSIT",
        "WITHDRAWAL",
        "INTEREST_PAYOUT",
        "PENALTY",
        "ADJUSTMENT",
        "TRANSFER",
      ];

      if (!allowedTypes.includes(data.transactionType)) {
        $("#TransactionType").addClass("is-invalid");
        valid = false;
      }

      const amountIsValid =
        /^\d+(\.\d{1,2})?$/.test(data.amount) && Number(data.amount) > 0;

      if (!amountIsValid) {
        $("#Amount").addClass("is-invalid");
        valid = false;
      }

      if (data.description.length > 1000) {
        $("#Description").addClass("is-invalid");
        valid = false;
      }

      return valid;
    }

    // ==========================
    // EVENTS
    // ==========================

    $(document).on("click", "#btnLedgerAdd", function () {
      openModal(null);
    });

    $("#ledgerTable").on("click", ".btn-edit", function () {
      const ledgerId = String($(this).attr("data-id") || "").trim();

      if (!isValidUUID(ledgerId)) {
        Swal.fire({
          icon: "error",
          title: "Update Failed",
          text: "Invalid Ledger ID.",
        });

        return;
      }

      const ledger = ledgerById[ledgerId];

      if (!ledger) {
        Swal.fire({
          icon: "error",
          title: "Update Failed",
          text: "Ledger record was not found.",
        });

        return;
      }

      openModal(ledger);
    });

    $("#ledgerForm").on("submit", async function (event) {
      event.preventDefault();

      const ledgerId = String($("#LedgerID").val() || "").trim();
      const isEdit = ledgerId !== "";
      const payload = getFormData();

      if (isEdit && !isValidUUID(ledgerId)) {
        Swal.fire({
          icon: "error",
          title: "Update Failed",
          text: "Invalid Ledger ID.",
        });

        return;
      }

      if (!validate(payload)) return;

      const confirmation = await Swal.fire({
        title: isEdit ? "Update Transaction?" : "Create Transaction?",
        text: isEdit
          ? "Are you sure you want to update this transaction? Balances will be recalculated."
          : "Are you sure you want to create this transaction?",
        icon: "question",
        showCancelButton: true,
        confirmButtonText: isEdit ? "Yes, update" : "Yes, create",
        cancelButtonText: "Cancel",
        confirmButtonColor: "#4e73df",
        cancelButtonColor: "#858796",
      });

      if (!confirmation.isConfirmed) return;

      Swal.fire({
        title: isEdit ? "Updating..." : "Creating...",
        allowOutsideClick: false,
        didOpen: function () {
          Swal.showLoading();
        },
      });

      try {
        if (isEdit) {
          await queryUtility.Update(
            "/savings-ledger/update-ledger/" + encodeURIComponent(ledgerId),
            payload,
          );
        } else {
          await queryUtility.Save("/savings-ledger/create-ledger", payload);
        }

        $("#ledgerModal").modal("hide");

        await loadLedger();

        Swal.close();

        Toast.fire({
          icon: "success",
          title: isEdit
            ? "Transaction updated successfully."
            : "Transaction created successfully.",
        });
      } catch (error) {
        console.error("Create/update ledger error:", error);

        Swal.fire({
          icon: "error",
          title: isEdit ? "Update Failed" : "Create Failed",
          text: errorMessage(error, "Something went wrong. Please try again."),
        });
      }
    });

    $("#ledgerTable").on("click", ".btn-delete", async function () {
      const ledgerId = String($(this).attr("data-id") || "").trim();

      if (!isValidUUID(ledgerId)) {
        Swal.fire({
          icon: "error",
          title: "Delete Failed",
          text: "Invalid Ledger ID.",
        });

        return;
      }

      const confirmation = await Swal.fire({
        title: "Delete Transaction?",
        text: "This action cannot be undone. Balances will be recalculated.",
        icon: "warning",
        showCancelButton: true,
        confirmButtonText: "Yes, delete",
        cancelButtonText: "Cancel",
        confirmButtonColor: "#d33",
      });

      if (!confirmation.isConfirmed) return;

      try {
        await queryUtility.Delete(
          "/savings-ledger/delete-ledger/" + encodeURIComponent(ledgerId),
        );

        await loadLedger();

        Toast.fire({
          icon: "success",
          title: "Transaction deleted successfully.",
        });
      } catch (error) {
        console.error("Delete ledger error:", error);

        Swal.fire({
          icon: "error",
          title: "Delete Failed",
          text: errorMessage(error, "Unable to delete transaction."),
        });
      }
    });

    loadLedger();
  });
</script>
