<script>
  $(document).ready(function () {
    "use strict";

    const API = "/savings-ledger";
    const PAGE_SIZE = 10;

    let transactions = [];
    let currentPage = 1;
    let searchTimer = null;

    const CREDIT_TYPES = ["DEPOSIT", "INTEREST_PAYOUT"];
    const DEBIT_TYPES = ["WITHDRAWAL", "PENALTY"];

    const TYPE_LABELS = {
      DEPOSIT: "Deposit",
      WITHDRAWAL: "Withdrawal",
      INTEREST_PAYOUT: "Interest Payout",
      PENALTY: "Penalty",
      ADJUSTMENT: "Adjustment",
      TRANSFER: "Transfer",
    };

    const Toast = Swal.mixin({
      toast: true,
      position: "top-end",
      showConfirmButton: false,
      timer: 3000,
      timerProgressBar: true,
    });

    function escapeHTML(value) {
      return String(value ?? "").replace(/[&<>"']/g, function (c) {
        return {
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#039;",
        }[c];
      });
    }

    function number(value) {
      const result = Number(value);
      return Number.isFinite(result) ? result : 0;
    }

    function money(value) {
      return (
        "PHP " +
        number(value).toLocaleString("en-PH", {
          minimumFractionDigits: 2,
          maximumFractionDigits: 2,
        })
      );
    }

    function dateText(value) {
      if (!value) return "-";

      const date = new Date(String(value).replace(" ", "T"));

      if (Number.isNaN(date.getTime())) {
        return String(value);
      }

      return date.toLocaleString("en-PH", {
        year: "numeric",
        month: "short",
        day: "2-digit",
        hour: "2-digit",
        minute: "2-digit",
      });
    }

    function getFilters() {
      return {
        q: $("#fSearch").val().trim(),
        member: $("#fMember").val(),
        type: $("#fType").val(),
        from: $("#fFrom").val(),
        to: $("#fTo").val(),
      };
    }

    function validDateRange() {
      const filters = getFilters();

      if (filters.from && filters.to && filters.from > filters.to) {
        Toast.fire({
          icon: "warning",
          title: "Start date cannot be after end date.",
        });
        return false;
      }

      return true;
    }

    function directionOf(row) {
      const type = String(row.transactionType || "").toUpperCase();

      if (CREDIT_TYPES.includes(type)) return "credit";
      if (DEBIT_TYPES.includes(type)) return "debit";

      if (row.previousBalance !== null && row.previousBalance !== undefined) {
        const difference =
          number(row.balanceAfter) - number(row.previousBalance);

        if (difference > 0) return "credit";
        if (difference < 0) return "debit";
      }

      if (number(row.amount) < 0) return "debit";

      return "neutral";
    }

    function typeLabel(type) {
      const key = String(type || "").toUpperCase();

      return TYPE_LABELS[key] || key.replace(/_/g, " ");
    }

    function badge(type) {
      const key = String(type || "").toUpperCase();
      let cssClass = "neutral";

      if (CREDIT_TYPES.includes(key)) cssClass = "credit";
      if (DEBIT_TYPES.includes(key)) cssClass = "debit";

      return `
            <span class="type-badge ${cssClass}">
                ${escapeHTML(typeLabel(key))}
            </span>
        `;
    }

    /* LOAD MEMBERS */

    function loadMembers() {
      $.ajax({
        url: API + "/load-member",
        method: "GET",
        dataType: "json",
      })
        .done(function (response) {
          const members = Array.isArray(response)
            ? response
            : response.data || [];

          const select = $("#fMember");

          select.empty().append('<option value="">All Members</option>');

          members.forEach(function (member) {
            select.append($("<option>").val(member.id).text(member.name));
          });
        })
        .fail(function (xhr) {
          console.error(xhr.responseText);

          Toast.fire({
            icon: "error",
            title: xhr.responseJSON?.message || "Unable to load members.",
          });
        });
    }

    /* LOAD TRANSACTIONS */

    function loadLedger() {
      if (!validDateRange()) return;

      $("#ledgerTable").html(`
            <tr>
                <td colspan="8" class="text-center py-5">
                    <i class="fas fa-spinner fa-spin mr-2"></i>
                    Loading transactions...
                </td>
            </tr>
        `);

      $.ajax({
        url: API + "/load-ledger",
        method: "GET",
        data: getFilters(),
        dataType: "json",
      })
        .done(function (response) {
          const rows = Array.isArray(response) ? response : response.data || [];

          transactions = rows.map(function (row) {
            return {
              ...row,
              amount: number(row.amount),
              balanceAfter: number(row.balanceAfter),
              previousBalance:
                row.previousBalance == null
                  ? null
                  : number(row.previousBalance),
            };
          });

          currentPage = 1;
          updateSummary();
          renderTable();
        })
        .fail(function (xhr) {
          console.error(xhr.responseText);

          transactions = [];
          updateSummary();

          $("#ledgerTable").html(`
                <tr>
                    <td colspan="8" class="text-center text-danger py-5">
                        ${escapeHTML(
                          xhr.responseJSON?.message ||
                            "Unable to load savings ledger.",
                        )}
                    </td>
                </tr>
            `);

          updatePagination(0, 0, 0);
        });
    }

    /* SUMMARY */

    function getTotals() {
      let credits = 0;
      let debits = 0;

      transactions.forEach(function (row) {
        const direction = directionOf(row);
        const amount = Math.abs(number(row.amount));

        if (direction === "credit") credits += amount;
        if (direction === "debit") debits += amount;
      });

      return {
        count: transactions.length,
        credits,
        debits,
        net: credits - debits,
      };
    }

    function updateSummary() {
      const summary = getTotals();

      $("#statCount").text(summary.count);
      $("#statCredits").text(money(summary.credits));
      $("#statDebits").text(money(summary.debits));

      $("#statNet")
        .text((summary.net >= 0 ? "+" : "-") + money(Math.abs(summary.net)))
        .removeClass("amt-credit amt-debit")
        .addClass(summary.net >= 0 ? "amt-credit" : "amt-debit");

      $("#recordCount").text(
        summary.count + (summary.count === 1 ? " Record" : " Records"),
      );
    }

    /* TABLE */

    function renderTable() {
      const total = transactions.length;

      if (!total) {
        $("#ledgerTable").html(`
                <tr>
                    <td colspan="8" class="text-center py-5">
                        <i class="fas fa-folder-open fa-2x text-muted mb-3 d-block"></i>
                        <strong>No transactions found</strong>
                        <div class="small text-muted mt-1">
                            Try changing your search or filters.
                        </div>
                    </td>
                </tr>
            `);

        currentPage = 1;
        updatePagination(0, 0, 0);
        return;
      }

      const start = (currentPage - 1) * PAGE_SIZE;
      const end = Math.min(start + PAGE_SIZE, total);

      let html = "";

      transactions.slice(start, end).forEach(function (row) {
        const direction = directionOf(row);

        const amountClass =
          direction === "credit"
            ? "amt-credit"
            : direction === "debit"
              ? "amt-debit"
              : "";

        const sign =
          direction === "credit" ? "+" : direction === "debit" ? "-" : "";

        html += `
                <tr>
                    <td>${escapeHTML(row.referenceNo || "-")}</td>
                    <td>${escapeHTML(dateText(row.createdDate))}</td>
                    <td>
                        <strong>${escapeHTML(row.memberName || "Unknown")}</strong>
                        <br>
                        <small class="text-muted">
                            ${escapeHTML(row.employeeId || "-")}
                        </small>
                    </td>
                    <td>${badge(row.transactionType)}</td>
                    <td class="text-right ${amountClass}">
                        ${sign}${money(Math.abs(number(row.amount)))}
                    </td>
                    <td class="text-right">
                        <strong>${money(row.balanceAfter)}</strong>
                    </td>
                    <td>${escapeHTML(row.description || "-")}</td>
                    <td>${escapeHTML(row.createdBy || "System")}</td>
                </tr>
            `;
      });

      $("#ledgerTable").html(html);
      updatePagination(start, end, total);
    }

    /* PAGINATION */

    function updatePagination(start, end, total) {
      const pages = Math.max(1, Math.ceil(total / PAGE_SIZE));

      $("#pageInfo").text(
        total
          ? `Showing ${start + 1} to ${end} of ${total} transactions`
          : "No transactions available",
      );

      $("#paginationInfo").text(
        total
          ? `Showing ${start + 1}–${end} of ${total} records`
          : "Showing 0 records",
      );

      $("#pageNumber").text(`${currentPage} / ${pages}`);

      $("#btnPrev").prop("disabled", currentPage <= 1);
      $("#btnNext").prop("disabled", currentPage >= pages);
    }

    $("#btnPrev").on("click", function () {
      if (currentPage > 1) {
        currentPage--;
        renderTable();
      }
    });

    $("#btnNext").on("click", function () {
      const pages = Math.ceil(transactions.length / PAGE_SIZE);

      if (currentPage < pages) {
        currentPage++;
        renderTable();
      }
    });

    /* SEARCH AND FILTERS */

    $("#fSearch").on("input", function () {
      clearTimeout(searchTimer);

      searchTimer = setTimeout(loadLedger, 350);
    });

    $("#fMember, #fType, #fFrom, #fTo").on("change", loadLedger);

    $("#btnClear").on("click", function () {
      clearTimeout(searchTimer);

      $("#fSearch, #fFrom, #fTo").val("");
      $("#fMember, #fType").val("");

      loadLedger();

      Toast.fire({
        icon: "success",
        title: "Filters cleared.",
      });
    });

    /* GENERATE PDF WITH CONFIRMATION */

    $("#btnReport").on("click", async function () {
      if (!validDateRange()) return;

      if (transactions.length === 0) {
        Toast.fire({
          icon: "warning",
          title: "There are no transactions to include in the report.",
        });
        return;
      }

      const filters = getFilters();

      const filterDescriptions = [];

      if (filters.q) filterDescriptions.push("Search: " + filters.q);
      if (filters.member) filterDescriptions.push("Selected member");
      if (filters.type)
        filterDescriptions.push("Type: " + typeLabel(filters.type));
      if (filters.from) filterDescriptions.push("From: " + filters.from);
      if (filters.to) filterDescriptions.push("To: " + filters.to);

      const filterSummary = filterDescriptions.length
        ? filterDescriptions.join(" • ")
        : "All transactions";

      const confirmation = await Swal.fire({
        icon: "warning",
        title: "Generate Savings Ledger Report?",
        html: `
                <div style="text-align:left; font-size:13px; line-height:1.8;">
                    <p>
                        You are about to generate a PDF report
                        containing <strong>${transactions.length}</strong>
                        transaction(s).
                    </p>

                    <div style="
                        padding:12px;
                        border-radius:9px;
                        background:rgba(167,25,32,.08);
                        border-left:4px solid #a71920;
                        margin-top:12px;
                    ">
                        <strong style="color:#a71920;">
                            Applied filters
                        </strong>
                        <div style="margin-top:5px;">
                            ${escapeHTML(filterSummary)}
                        </div>
                    </div>

                    <p style="margin-top:12px; color:#888;">
                        Please verify the selected filters before
                        generating the official report.
                    </p>
                </div>
            `,
        showCancelButton: true,
        confirmButtonText: '<i class="fas fa-file-pdf mr-1"></i> Generate PDF',
        cancelButtonText: "Cancel",
        reverseButtons: true,
        focusCancel: true,
        confirmButtonColor: "#a71920",
        cancelButtonColor: "#555",
      });

      if (!confirmation.isConfirmed) {
        return;
      }

      const $button = $(this);
      const originalHTML = $button.html();

      $button
        .prop("disabled", true)
        .html('<i class="fas fa-spinner fa-spin"></i>');

      try {
        const query = $.param(filters);

        const response = await fetch(`${API}/generate-report?${query}`, {
          method: "GET",
          credentials: "same-origin",
        });

        if (!response.ok) {
          let message = "Unable to generate PDF report.";

          try {
            const body = await response.json();
            message = body.message || message;
          } catch (error) {
            // Response did not contain JSON.
          }

          throw new Error(message);
        }

        const blob = await response.blob();

        if (!blob.size || blob.type !== "application/pdf") {
          throw new Error("The server did not return a valid PDF file.");
        }

        const disposition = response.headers.get("Content-Disposition") || "";

        const match = disposition.match(/filename="?([^"]+)"?/i);

        const filename = match ? match[1] : "5L_Savings_Ledger_Report.pdf";

        const downloadURL = URL.createObjectURL(blob);

        const link = document.createElement("a");
        link.href = downloadURL;
        link.download = filename;

        document.body.appendChild(link);
        link.click();
        link.remove();

        setTimeout(function () {
          URL.revokeObjectURL(downloadURL);
        }, 1500);

        await Swal.fire({
          icon: "success",
          title: "PDF Report Generated",
          text: "Your 5L Savings Ledger report has been downloaded.",
          confirmButtonColor: "#a71920",
        });
      } catch (error) {
        console.error("PDF generation error:", error);

        Swal.fire({
          icon: "error",
          title: "PDF Generation Failed",
          text: error.message || "Please try again.",
          confirmButtonColor: "#a71920",
        });
      } finally {
        $button.prop("disabled", false).html(originalHTML);
      }
    });

    /* INITIAL LOAD */

    loadMembers();
    loadLedger();
  });
</script>
