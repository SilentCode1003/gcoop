<script>
$(document).ready(function () {

    function formatDate(date) {
        if (!date) return "";
        return new Date(date).toLocaleString();
    }

    const esc = (v) =>
        String(v ?? "").replace(/[&<>"']/g, (c) => ({
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#39;",
        })[c]);

    const Toast = Swal.mixin({
        toast: true,
        position: "top-end",
        showConfirmButton: false,
        timer: 2500,
        timerProgressBar: true,
    });

    const errorMessage = (err, fallback) =>
        err?.responseJSON?.message || fallback;

    // ==========================
    // LOAD PROFILE
    // ==========================
    async function loadProfile() {

        try {

            const profile = await queryUtility.Load("/profile/loadProfile");

            $("#userId").val(profile.id);

            $("#profileFullName").text(esc(profile.fullname));
            $("#profileRole").text(esc(profile.role));

            $("#fullName").val(profile.fullname);
            $("#username").val(profile.username);
            $("#role").val(profile.role);
            $("#createdAt").val(formatDate(profile.createdat));

        } catch (err) {

            Swal.fire({
                icon: "error",
                title: "Load Failed",
                text: errorMessage(err, "Unable to load profile."),
                confirmButtonColor: "#991b1b",
            });

        }

    }

    // ==========================
    // GET FORM DATA
    // ==========================
    function getFormData() {

        return {
            Password: $("#newPassword").val().trim(),
            ConfirmPassword: $("#confirmPassword").val().trim(),
        };

    }

    // ==========================
    // VALIDATION
    // ==========================
    function validate(data) {

        let valid = true;

        $("#newPassword").removeClass("is-invalid");
        $("#confirmPassword").removeClass("is-invalid");

        if (!data.Password) {
            $("#newPassword").addClass("is-invalid");
            valid = false;
        }

        if (!data.ConfirmPassword) {
            $("#confirmPassword").addClass("is-invalid");
            valid = false;
        }

        if (!valid) return false;

        if (data.Password.length < 6) {

            $("#newPassword").addClass("is-invalid");

            Swal.fire({
                icon: "warning",
                title: "Invalid Password",
                text: "Password must be at least 6 characters.",
                confirmButtonColor: "#991b1b",
            });

            return false;

        }

        if (data.Password !== data.ConfirmPassword) {

            $("#confirmPassword").addClass("is-invalid");

            Swal.fire({
                icon: "warning",
                title: "Passwords do not match.",
                confirmButtonColor: "#991b1b",
            });

            return false;

        }

        return true;

    }

    // ==========================
    // SAVE PASSWORD
    // ==========================
    $("#profileForm").submit(async function (e) {

        e.preventDefault();

        const payload = getFormData();

        if (!validate(payload)) return;

        const result = await Swal.fire({
            title: "Update Password?",
            text: "Your password will be changed.",
            icon: "question",
            showCancelButton: true,
            confirmButtonText: "Yes, Update",
            cancelButtonText: "Cancel",
            confirmButtonColor: "#991b1b",
        });

        if (!result.isConfirmed) return;

        Swal.fire({
            title: "Saving...",
            allowOutsideClick: false,
            didOpen: () => Swal.showLoading(),
        });

        try {

            await queryUtility.Update(
                "/profile/updatePassword",
                {
                    Password: payload.Password
                }
            );

            $("#newPassword").val("");
            $("#confirmPassword").val("");

            Swal.close();

            Toast.fire({
                icon: "success",
                title: "Password updated successfully.",
            });

        } catch (err) {

            Swal.fire({
                icon: "error",
                title: "Update Failed",
                text: errorMessage(err, "Something went wrong."),
                confirmButtonColor: "#991b1b",
            });

        }

    });

    // ==========================
    // INITIAL LOAD
    // ==========================
    loadProfile();

});
</script>