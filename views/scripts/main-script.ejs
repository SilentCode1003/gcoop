
<!-- Bootstrap core JavaScript -->
<script src="/vendor/jquery/jquery.min.js"></script>

<!-- Select2 -->
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

<script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

<!-- Core plugin JavaScript -->
<script src="/vendor/jquery-easing/jquery.easing.min.js"></script>

<!-- SB Admin -->
<script src="/javascripts/sb-admin-2.min.js"></script>

<script>

// =====================================
// ROLE NAME
// =====================================
const roleName = "<%= typeof roleName !== 'undefined' ? roleName : '' %>";

// =====================================
// AJAX UTILITY
// =====================================
function Query(url, type, data = null) {

    return new Promise(function (resolve, reject) {

        $.ajax({
            url: url,
            method: type,
            dataType: "json",

            contentType: ["POST", "PUT", "PATCH", "DELETE"].includes(type)
                ? "application/json"
                : undefined,

            data: data && ["POST", "PUT", "PATCH", "DELETE"].includes(type)
                ? JSON.stringify(data)
                : undefined,

            success: resolve,
            error: reject
        });

    });
}

const queryUtility = {
    Load: (url) => Query(url, "GET"),
    Save: (url, data) => Query(url, "POST", data),
    Update: (url, data) => Query(url, "PUT", data),
    Delete: (url) => Query(url, "DELETE")
};

// =====================================
// LOGOUT
// =====================================
$(document).on("click", "#logoutModal .btn-primary", async function (e) {

    e.preventDefault();

    try {

        await queryUtility.Save("/auth/logout");

        window.location.href = "/auth";

    } catch (err) {

        Swal.fire({
            icon: "error",
            title: "Logout Failed",
            text: err.responseJSON?.message || "Unable to logout."
        });

    }

});

// =====================================
// GLOBAL LIGHT / DARK THEME
// =====================================
$(function () {

    const html = document.documentElement;
    const body = document.body;

    function updateThemeIcon() {

        const isDark = html.classList.contains("dark");
        const btn = $("#themeBtn");

        btn.html(
            isDark
                ? '<i class="fas fa-sun"></i>'
                : '<i class="fas fa-moon"></i>'
        );

        btn.attr("aria-pressed", String(isDark));

        btn.attr(
            "aria-label",
            isDark ? "Switch to Light Mode" : "Switch to Dark Mode"
        );
    }

    function applyTheme(theme) {

        const isDark = theme === "dark";

        html.classList.toggle("dark", isDark);
        body.classList.toggle("dark", isDark);

        updateThemeIcon();
    }

    // Load saved theme
    let savedTheme = "light";

    try {
        savedTheme = localStorage.getItem("theme") || "light";
    } catch (error) {
        console.warn("Unable to read saved theme.");
    }

    applyTheme(savedTheme);

    // Remove previous global handler and attach one handler
    $(document)
        .off("click.globalTheme", "#themeBtn")
        .on("click.globalTheme", "#themeBtn", function (e) {

            e.preventDefault();

            const newTheme = html.classList.contains("dark")
                ? "light"
                : "dark";

            try {
                localStorage.setItem("theme", newTheme);
            } catch (error) {
                console.warn("Unable to save theme.");
            }

            applyTheme(newTheme);

            console.log("Current theme:", newTheme);

        });

});

// =====================================
// NAVBAR SEARCH
// =====================================
$(function () {

    const $form = $(".navbar-search");
    const $input = $form.find("input");
    const $button = $form.find("button");

    function filterTable() {

        const q = $input.val().toLowerCase().trim();

        $("#dataTable tbody tr").each(function () {

            $(this).toggle(
                $(this).text().toLowerCase().includes(q)
            );

        });
    }

    window.filterTable = filterTable;

    $input.on("input", filterTable);
    $button.on("click", filterTable);

    $form.on("submit", function (e) {

        e.preventDefault();

        filterTable();

    });

});

// =====================================
// ROLE ACCESS
// =====================================
$(function () {

    if (roleName === "Custodian") {

        $("#menuUsers").hide();
        $("#menuRoles").hide();
        $("#menuRoutes").hide();
        $("#menuPermissions").hide();

    }

});

</script>
