<!-- Bootstrap core JavaScript -->
<script src="/vendor/jquery/jquery.min.js"></script>
<script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

<!-- Core plugin JavaScript -->
<script src="/vendor/jquery-easing/jquery.easing.min.js"></script>

<!-- SB Admin -->
<script src="/javascripts/sb-admin-2.min.js"></script>

<script>
    // ==========================
    // AJAX Utility
    // ==========================

    function Query(url, type, data = null) {

        return new Promise(function (resolve, reject) {

            $.ajax({
                url: url,
                method: type,
                dataType: "json",

                contentType:
                    ["POST", "PUT", "PATCH", "DELETE"].includes(type)
                        ? "application/json"
                        : undefined,

                data:
                    data &&
                    ["POST", "PUT", "PATCH", "DELETE"].includes(type)
                        ? JSON.stringify(data)
                        : undefined,

                success: resolve,
                error: reject
            });

        });

    }

    const queryUtility = {

        Load(url) {
            return Query(url, "GET");
        },

        Save(url, data) {
            return Query(url, "POST", data);
        },

        Update(url, data) {
            return Query(url, "PUT", data);
        },

        Delete(url) {
            return Query(url, "DELETE");
        }

    };

    // ==========================
    // Logout
    // ==========================

    $(document).on("click", "#logoutModal .btn-primary", async function (e) {

        e.preventDefault();

        try {

            await queryUtility.Save("/auth/logout");
            window.location.href = "/auth";

        } catch (err) {

            Swal.fire({
                icon: "error",
                title: "Logout Failed",
                text: err.responseJSON?.message || "Unable to logout."
            });

        }

    });

    // ==========================
    // Theme
    // ==========================
    $(function () {

        const html = $("html");
        const body = $("body");
        const btn = $("#themeBtn");
        const icon = $("#themeBtn i");

        const theme = localStorage.getItem("theme") || "light";

        function applyTheme(theme) {

            if (theme === "dark") {
                html.addClass("dark");
                body.addClass("dark");
                icon.removeClass("fa-moon").addClass("fa-sun");
            } else {
                html.removeClass("dark");
                body.removeClass("dark");
                icon.removeClass("fa-sun").addClass("fa-moon");
            }

        }

        // Apply saved theme
        applyTheme(theme);

        // Exit if no theme button exists
        if (!btn.length) return;

        // Toggle Theme
        btn.off("click").on("click", function () {

            const dark = !html.hasClass("dark");

            applyTheme(dark ? "dark" : "light");

            localStorage.setItem("theme", dark ? "dark" : "light");

        });

    });


</script>