<!-- Bootstrap core JavaScript -->
<script src="/vendor/jquery/jquery.min.js"></script>
<script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>

<!-- Core plugin JavaScript -->
<script src="/vendor/jquery-easing/jquery.easing.min.js"></script>

<!-- SB Admin -->
<script src="/javascripts/sb-admin-2.min.js"></script>

<script>
    // ==========================
    // AJAX Utility
    // ==========================

    const Query = (url, type, data = null) => {

        return new Promise((resolve, reject) => {

            $.ajax({

                url: url,
                method: type,
                dataType: "json",

                contentType:
                    ["POST", "PUT", "PATCH", "DELETE"].includes(type)
                        ? "application/json"
                        : undefined,

                data:
                    data &&
                    ["POST", "PUT", "PATCH", "DELETE"].includes(type)
                        ? JSON.stringify(data)
                        : undefined,

                success: function (result) {
                    resolve(result);
                },

                error: function (err) {
                    console.error(err);
                    reject(err);
                }

            });

        });

    };

    const queryUtility = {

        Load(url) {
            return Query(url, "GET");
        },

        Save(url, data) {
            return Query(url, "POST", data);
        },

        Update(url, data) {
            return Query(url, "PUT", data);
        },

        Delete(url) {
            return Query(url, "DELETE");
        }

    };

    // ==========================
    // Logout
    // ==========================

    $(document).on("click", "#logoutModal .btn-primary", async function (e) {

        e.preventDefault();

        try {

            await queryUtility.Save("/auth/logout");
            window.location.href = "/auth";

        } catch (err) {

            Swal.fire({
                icon: "error",
                title: "Logout Failed",
                text: err.responseJSON?.message || "Unable to logout."
            });

        }

    });

    // ==========================
    // Dark / Light Mode
    // ==========================

    $(document).ready(function () {

        // Load saved theme
        if (localStorage.getItem("theme") === "dark") {

            $("body").addClass("dark");

            $("#themeBtn i")
                .removeClass("fa-moon")
                .addClass("fa-sun");

        }

        // Toggle Theme
        $("#themeBtn").click(function () {

            $("body").toggleClass("dark");

            if ($("body").hasClass("dark")) {

                localStorage.setItem("theme", "dark");

                $("#themeBtn i")
                    .removeClass("fa-moon")
                    .addClass("fa-sun");

            } else {

                localStorage.setItem("theme", "light");

                $("#themeBtn i")
                    .removeClass("fa-sun")
                    .addClass("fa-moon");

            }

        });

    });
</script>