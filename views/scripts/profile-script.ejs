<script>
  $(document).ready(function () {
    const Toast = Swal.mixin({
      toast: true,
      position: "top-end",
      showConfirmButton: false,
      timer: 2500,
      timerProgressBar: true,
    });

    const errorMessage = (err, fallback) =>
      err?.responseJSON?.message || fallback;

    const formatDate = (date) => (date ? new Date(date).toLocaleString() : "");

    let original = {};

    // ==========================
    // EDIT MODE (full name, username and password only)
    // ==========================
    function setEditing(on) {
      $("#fullName, #username").prop("readonly", !on);
      $("#editActions, #passwordSection").toggleClass("d-none", !on);
      $("#btnEdit").toggleClass("d-none", on);

      if (!on) {
        $("#profileForm .form-control").removeClass("is-invalid");
        $("#currentPassword, #newPassword, #confirmPassword").val("");
      }
    }

    function fill(profile) {
      $("#profileFullName").text(profile.fullName ?? "");
      $("#profileRole").text(profile.role ?? "");
      $("#profileUsername").text("@" + (profile.username ?? ""));

      $("#fullName").val(profile.fullName ?? "");
      $("#username").val(profile.username ?? "");
      $("#role").val(profile.role ?? "");
      $("#createdDate").val(formatDate(profile.createdDate));
      $("#updatedDate").val(formatDate(profile.updatedDate));
    }

    // ==========================
    // LOAD PROFILE
    // ==========================
    async function loadProfile() {
      try {
        const profile = await queryUtility.Load("/profile/loadProfile");

        if (!profile) {
          throw new Error("Profile not found.");
        }

        original = profile;
        fill(profile);
      } catch (err) {
        console.error(err);

        Swal.fire({
          icon: "error",
          title: "Unable to load profile",
          text: errorMessage(err, "Something went wrong."),
          confirmButtonColor: "#991b1b",
        });
      }
    }

    // ==========================
    // GET FORM DATA
    // ==========================
    function getFormData() {
      return {
        FullName: $("#fullName").val().trim(),
        Username: $("#username").val().trim(),
        CurrentPassword: $("#currentPassword").val(),
        NewPassword: $("#newPassword").val(),
        ConfirmPassword: $("#confirmPassword").val(),
      };
    }

    // ==========================
    // VALIDATE
    // ==========================
    function validate(data) {
      const wantsNewPassword = !!data.NewPassword;

      const checks = {
        "#fullName": !!data.FullName,
        "#username": !!data.Username,
        "#currentPassword": !wantsNewPassword || !!data.CurrentPassword,
        "#newPassword": !wantsNewPassword || data.NewPassword.length >= 6,
        "#confirmPassword":
          !wantsNewPassword || data.NewPassword === data.ConfirmPassword,
      };

      let valid = true;

      $.each(checks, function (selector, ok) {
        $(selector).toggleClass("is-invalid", !ok);
        if (!ok) valid = false;
      });

      return valid;
    }

    // ==========================
    // EDIT / CANCEL
    // ==========================
    $("#btnEdit").on("click", () => setEditing(true));

    $("#btnCancel").on("click", function () {
      fill(original);
      setEditing(false);
    });

    // ==========================
    // SAVE
    // ==========================
    $("#profileForm").on("submit", async function (e) {
      e.preventDefault();

      const data = getFormData();

      if (!validate(data)) return;

      // ConfirmPassword is only for the check above, so the server never gets it
      const { ConfirmPassword, ...payload } = data;

      const confirm = await Swal.fire({
        title: "Save changes?",
        text: "Update your profile?",
        icon: "question",
        showCancelButton: true,
        confirmButtonText: "Yes, Save",
        cancelButtonText: "Cancel",
        confirmButtonColor: "#991b1b",
        cancelButtonColor: "#6c757d",
      });

      if (!confirm.isConfirmed) return;

      Swal.fire({
        title: "Saving...",
        allowOutsideClick: false,
        didOpen: () => Swal.showLoading(),
      });

      try {
        await queryUtility.Update("/profile/updateProfile", payload);

        await loadProfile();
        setEditing(false);
        Swal.close();

        Toast.fire({
          icon: "success",
          title: "Profile updated successfully",
        });
      } catch (err) {
        Swal.fire({
          icon: "error",
          title: "Update failed",
          text: errorMessage(err, "Something went wrong."),
          confirmButtonColor: "#991b1b",
        });
      }
    });

    // ==========================
    // INITIAL LOAD
    // ==========================
    loadProfile();
  });
</script>
