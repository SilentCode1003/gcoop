<script>
  $(document).ready(function () {
    let routesById = {};

    const Toast = Swal.mixin({
      toast: true,
      position: "top-end",
      showConfirmButton: false,
      timer: 2500,
      timerProgressBar: true,
    });

    function esc(v) {
      return String(v ?? "").replace(/[&<>"']/g, function (c) {
        return {
          "&": "&amp;",
          "<": "&lt;",
          ">": "&gt;",
          '"': "&quot;",
          "'": "&#39;",
        }[c];
      });
    }

    // ---------- LOAD ----------
    async function loadRoutes() {
      const routes = await queryUtility.Load("/routes/loadRoute");
      const $tbody = $("#routeTable").empty();
      routesById = {};

      for (const route of routes) {
        routesById[route.id] = route;
        $tbody.append(`
                    <tr>
                        <td>${esc(route.id)}</td>
                        <td>${esc(route.name)}</td>
                        <td>${formatDate(route.createdDate)}</td>
                        <td>${formatDate(route.updatedDate)}</td>
                        <td>
                          <div class="d-flex justify-content-center align-items-center action-buttons">
                           <button type="button"
                                class="btn btn-secondary btn-sm mb-1 btn-edit"
                                data-id="${esc(route.id)}">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button type="button"
                                class="btn btn-danger btn-sm mb-1 btn-delete"
                                data-id="${esc(route.id)}">
                                <i class="fas fa-trash"></i>
                            </button>
                            </div>

                        </td>
                    </tr>
                `);
      }
    }
    // ==========================
    // OPEN MODAL
    // ==========================
    function openModal(route = null) {
      $("#routesForm")[0].reset();

      $("#routesId").val("");

      if (route) {
        $("#modalTitle").text("Edit Route");

        $("#routesId").val(route.id);
        $("#routeName").val(route.name);
      } else {
        $("#modalTitle").text("Add Route");
      }

      $("#routesModal").modal("show");
    }

    // ==========================
    // GET FORM DATA
    // ==========================
    function getFormData() {
      return {
        name: $("#routeName").val().trim(),
      };
    }

    // ==========================
    // VALIDATE
    // ==========================
    function validate(data) {
      let valid = true;

      $("#routeName").toggleClass("is-invalid", !data.name);

      if (!data.name) {
        valid = false;
      }

      return valid;
    }

    // ==========================
    // ADD BUTTON
    // ==========================
    $("#btnAdd").click(function () {
      openModal();
    });

    // ==========================
    // EDIT BUTTON
    // ==========================
    $("#routeTable").on("click", ".btn-edit", function () {
      const route = routesById[$(this).data("id")];

      if (route) {
        openModal(route);
      }
    });

    // ==========================
    // SAVE
    // ==========================
    $("#routesForm").on("submit", async function (e) {
      e.preventDefault();

      const id = $("#routesId").val();
      const isEdit = id !== "";
      const payload = getFormData();
      if (!validate(payload)) return;

      const confirm = await Swal.fire({
        title: isEdit ? "Save changes?" : "Add this Route?",
        text: isEdit
          ? `Update ${payload.name}'s record?`
          : `Add ${payload.name} to the list?`,
        icon: "question",
        showCancelButton: true,
        confirmButtonText: isEdit ? "Yes, save" : "Yes, add",
        cancelButtonText: "Cancel",
        confirmButtonColor: "#4e73df",
        cancelButtonColor: "#858796",
      });
      if (!confirm.isConfirmed) return;

      Swal.fire({
        title: "Saving...",
        allowOutsideClick: false,
        didOpen: () => Swal.showLoading(),
      });

      try {
        if (isEdit) {
          await queryUtility.Update(
            `/routes/updateRoute/${encodeURIComponent(id)}`,
            payload,
          );
        } else {
          await queryUtility.Save("/routes/createRoute", payload);
        }

        $("#routesModal").modal("hide");
        await loadRoutes();
        Swal.close();
        Toast.fire({
          icon: "success",
          title: isEdit
            ? "Route updated successfully"
            : "Route added successfully",
        });
      } catch (err) {
        Swal.fire({
          icon: "error",
          title: isEdit ? "Update failed" : "Create failed",
          text: errorMessage(err, "Something went wrong. Please try again."),
          confirmButtonColor: "#4e73df",
        });
      }
    });

    // ==========================
    // DELETE
    // ==========================
    $("#routeTable").on("click", ".btn-delete", async function () {
      const id = $(this).data("id");

      const result = await Swal.fire({
        title: "Delete Route?",
        text: "This action cannot be undone.",
        icon: "warning",
        showCancelButton: true,
        confirmButtonColor: "#991b1b",
        confirmButtonText: "Delete",
      });

      if (!result.isConfirmed) {
        return;
      }

      try {
        await queryUtility.Delete("/routes/deleteRoute/" + id);

        Toast.fire({
          icon: "success",
          title: "Route deleted.",
        });

        loadRoutes();
      } catch (err) {
        console.error(err);

        Swal.fire("Error", "Unable to delete route.", "error");
      }
    });

    // ==========================
    // FORMAT DATE
    // ==========================
    function formatDate(date) {
      if (!date) return "";

      const d = new Date(date);

      return d.toLocaleDateString() + " " + d.toLocaleTimeString();
    }

    // ==========================
    // INITIALIZE
    // ==========================
    loadRoutes();
  });
</script>
