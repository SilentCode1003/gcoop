<ul
  class="navbar-nav bg-gradient-primary sidebar sidebar-dark accordion"
  id="accordionSidebar"
>
  <!-- Brand -->
  <a
    class="sidebar-brand d-flex align-items-center justify-content-center"
    href="/dashboard"
  >
    <div class="sidebar-brand-icon">
      <img
        src="/images/logo.png"
        class="sidebar-logo"
        alt="5L Solutions Coop"
      />
    </div>

    <div class="sidebar-brand-text mx-2">5L SOLUTIONS<br />COOP</div>
  </a>

  <hr class="sidebar-divider my-0" />

  <!-- Dashboard (always visible) -->
  <li
    class="nav-item <%= title === 'Dashboard' ? 'active' : '' %>"
    id="menuDashboard"
  >
    <a class="nav-link" href="/dashboard">
      <img src="/images/dashboard.png" width="22" />
      <span>Dashboard</span>
    </a>
  </li>

  <% const showMasterFiles =
    can("Members") || can("Users") || can("Roles") || can("Routes"); %>

  <% if (showMasterFiles) { %>
  <hr class="sidebar-divider" />

  <!-- Master Files -->
  <div class="sidebar-heading">Master Files</div>
  <% } %>

  <!-- Members -->
  <% if (can("Members")) { %>
  <li
    class="nav-item <%= title === 'Members' ? 'active' : '' %>"
    id="menuMembers"
  >
    <a class="nav-link" href="/members">
      <i class="fas fa-users"></i>
      <span>Members</span>
    </a>
  </li>
  <% } %>

  <!-- Users -->
  <% if (can("Users")) { %>
  <li
    class="nav-item <%= title === 'User Accounts' ? 'active' : '' %>"
    id="menuUsers"
  >
    <a class="nav-link" href="/users">
      <i class="fas fa-user"></i>
      <span>Users</span>
    </a>
  </li>
  <% } %>

  <!-- Roles & Permissions -->
  <% if (can("Roles")) { %>
  <li
    class="nav-item <%= title === 'Roles & Permissions' ? 'active' : '' %>"
    id="menuRoles"
  >
    <a class="nav-link" href="/roles">
      <i class="fas fa-user-shield"></i>
      <span>Roles &amp; Permissions</span>
    </a>
  </li>
  <% } %>

  <!-- Routes -->
  <% if (can("Routes")) { %>
  <li
    class="nav-item <%= title === 'Routes' ? 'active' : '' %>"
    id="menuRoutes"
  >
    <a class="nav-link" href="/routes">
      <i class="fas fa-route"></i>
      <span>Routes</span>
    </a>
  </li>
  <% } %>

  <% const showLoanManagement =
    can("Loan Rates") || can("Denominations") ||
    can("Member Savings") || can("Savings Ledger"); %>

  <% if (showLoanManagement) { %>
  <hr class="sidebar-divider" />

  <!-- Loan Management -->
  <div class="sidebar-heading">Loan Management</div>
  <% } %>

  <!-- Loan Rates -->
  <% if (can("Loan Rates")) { %>
  <li
    class="nav-item <%= title === 'Loan Rates' ? 'active' : '' %>"
    id="menuLoanRates"
  >
    <a class="nav-link" href="/loan-rates">
      <i class="fas fa-percent"></i>
      <span>Loan Rates</span>
    </a>
  </li>
  <% } %>

  <!-- Denominations -->
  <% if (can("Denominations")) { %>
  <li
    class="nav-item <%= title === 'Denominations' ? 'active' : '' %>"
    id="menuDenominations"
  >
    <a class="nav-link" href="/denominations">
      <i class="fas fa-coins"></i>
      <span>Denominations</span>
    </a>
  </li>
  <% } %>

  <!-- Member Savings -->
  <% if (can("Member Savings")) { %>
  <li
    class="nav-item <%= title === 'Member Savings' ? 'active' : '' %>"
    id="menuMemberSavings"
  >
    <a class="nav-link" href="/member-savings">
      <i class="fas fa-piggy-bank"></i>
      <span>Member Savings</span>
    </a>
  </li>
  <% } %>

  <!-- Savings Ledger -->
  <% if (can("Savings Ledger")) { %>
  <li
    class="nav-item <%= title === 'Savings Ledger' ? 'active' : '' %>"
    id="menuSavingsLedger"
  >
    <a class="nav-link" href="/savings-ledger">
      <i class="fas fa-book"></i>
      <span>Savings Ledger</span>
    </a>
  </li>
  <% } %>

