  <!-- Sidebar Toggle -->
  <div class="text-center d-none d-md-inline">
    <button class="rounded-circle border-0" id="sidebarToggle"></button>
  </div>

  <!-- Footer -->
  <div class="sidebar-card d-none d-lg-flex">
    <img class="sidebar-card-illustration" src="/images/logo.png" />

    <p class="text-center mb-2">
      <strong
        >FINDING SOLUTIONS AT <span class="span1">IT's</span> BEST!</strong
      >
    </p>

    <a
      class="btn btn-danger btn-sm"
      href="https://www.facebook.com/5LSolutions"
      target="_blank"
    >
      Visit our Page
    </a>
  </div>
