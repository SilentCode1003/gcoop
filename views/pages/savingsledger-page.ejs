<div class="container-fluid savings-ledger-page">
  <div class="ledger-page-heading">
    <div class="ledger-heading-icon">
      <i class="fas fa-book"></i>
    </div>
    <div>
      <h2>Savings Ledger</h2>
      <p>Monitor, review, and generate savings transaction reports.</p>
    </div>
  </div>

  <div class="card shadow mb-4 savings-ledger-table">
    <div class="card-header ledger-card-header">
      <div class="ledger-header-title">
        <i class="fas fa-piggy-bank"></i>
        <div>
          <h5>Savings Ledger</h5>
          <small>Transaction Management</small>
        </div>
      </div>

      <button
        type="button"
        id="btnReport"
        class="btn btn-pdf"
        title="Generate PDF Report"
        aria-label="Generate PDF Report"
      >
        <i class="fas fa-file-pdf"></i>
      </button>
    </div>

    <div class="card-body">
      <!-- SUMMARY CARDS -->
      <div class="row ledger-summary-row">
        <div class="col-xl-3 col-md-6 col-6 mb-3">
          <div class="ledger-stat stat-total">
            <div class="stat-icon">
              <i class="fas fa-exchange-alt"></i>
            </div>
            <div>
              <div class="label">Transactions</div>
              <div class="value" id="statCount">0</div>
            </div>
          </div>
        </div>

        <div class="col-xl-3 col-md-6 col-6 mb-3">
          <div class="ledger-stat stat-credit">
            <div class="stat-icon">
              <i class="fas fa-arrow-down"></i>
            </div>
            <div>
              <div class="label">Total Credits</div>
              <div class="value" id="statCredits">PHP 0.00</div>
            </div>
          </div>
        </div>

        <div class="col-xl-3 col-md-6 col-6 mb-3">
          <div class="ledger-stat stat-debit">
            <div class="stat-icon">
              <i class="fas fa-arrow-up"></i>
            </div>
            <div>
              <div class="label">Total Debits</div>
              <div class="value" id="statDebits">PHP 0.00</div>
            </div>
          </div>
        </div>

        <div class="col-xl-3 col-md-6 col-6 mb-3">
          <div class="ledger-stat stat-net">
            <div class="stat-icon">
              <i class="fas fa-chart-line"></i>
            </div>
            <div>
              <div class="label">Net Change</div>
              <div class="value" id="statNet">PHP 0.00</div>
            </div>
          </div>
        </div>
      </div>

      <!-- FILTER SECTION -->
      <div class="ledger-filter-section">
        <div class="ledger-filter-heading">
          <div>
            <i class="fas fa-filter"></i>
            <span>Search and Filters</span>
          </div>

          <button type="button" id="btnClear" class="btn btn-clear-filter">
            <i class="fas fa-undo mr-1"></i>
            Clear Filters
          </button>
        </div>

        <div class="row">
          <div class="col-xl-3 col-md-6 mb-3">
            <label for="fSearch">Search Transactions</label>
            <div class="ledger-input-group">
              <i class="fas fa-search"></i>
              <input
                type="search"
                id="fSearch"
                class="form-control"
                placeholder="Reference, member, description..."
                autocomplete="off"
              />
            </div>
          </div>

          <div class="col-xl-2 col-md-6 mb-3">
            <label for="fMember">Member</label>
            <div class="ledger-input-group">
              <i class="fas fa-user"></i>
              <select id="fMember" class="form-control">
                <option value="">All Members</option>
              </select>
            </div>
          </div>

          <div class="col-xl-2 col-md-4 mb-3">
            <label for="fType">Transaction Type</label>
            <div class="ledger-input-group">
              <i class="fas fa-exchange-alt"></i>
              <select id="fType" class="form-control">
                <option value="">All Types</option>
                <option value="DEPOSIT">Deposit</option>
                <option value="WITHDRAWAL">Withdrawal</option>
                <option value="INTEREST_PAYOUT">Interest Payout</option>
                <option value="PENALTY">Penalty</option>
                <option value="ADJUSTMENT">Adjustment</option>
                <option value="TRANSFER">Transfer</option>
              </select>
            </div>
          </div>

          <div class="col-xl-2 col-md-4 mb-3">
            <label for="fFrom">Start Date</label>
            <div class="ledger-input-group">
              <i class="fas fa-calendar-alt"></i>
              <input type="date" id="fFrom" class="form-control" />
            </div>
          </div>

          <div class="col-xl-2 col-md-4 mb-3">
            <label for="fTo">End Date</label>
            <div class="ledger-input-group">
              <i class="fas fa-calendar-check"></i>
              <input type="date" id="fTo" class="form-control" />
            </div>
          </div>
        </div>
      </div>

      <!-- TABLE HEADER -->
      <div class="ledger-table-heading">
        <div>
          <h6>
            <i class="fas fa-list-alt mr-2"></i>
            Transaction Records
          </h6>
          <small id="pageInfo">Loading transactions...</small>
        </div>

        <div class="ledger-record-count">
          <i class="fas fa-database"></i>
          <span id="recordCount">0 Records</span>
        </div>
      </div>

      <!-- TABLE -->
      <div class="ledger-table-container">
        <div class="table-responsive">
          <table id="savingsLedgerTable" class="table table-hover mb-0">
            <thead>
              <tr>
                <th>Reference No.</th>
                <th>Date</th>
                <th>Member</th>
                <th>Type</th>
                <th class="text-right">Amount</th>
                <th class="text-right">Balance After</th>
                <th>Description</th>
                <th>Created By</th>
              </tr>
            </thead>

            <tbody id="ledgerTable">
              <tr>
                <td colspan="8" class="text-center py-5">
                  <i class="fas fa-spinner fa-spin mr-2"></i>
                  Loading savings ledger...
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- PAGINATION -->
      <div class="ledger-pagination">
        <div class="pagination-info">
          <span id="paginationInfo">Showing 0 records</span>
        </div>

        <div class="pagination-controls">
          <button type="button" id="btnPrev" class="btn btn-page">
            <i class="fas fa-chevron-left"></i>
          </button>

          <span id="pageNumber">1 / 1</span>

          <button type="button" id="btnNext" class="btn btn-page">
            <i class="fas fa-chevron-right"></i>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
