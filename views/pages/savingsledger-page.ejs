<div class="container-fluid">
  <!-- Savings Ledger Card -->
  <div class="card shadow mb-4 savings-ledger-table">
    <div
      class="card-header d-flex justify-content-between align-items-center flex-wrap"
    >
      <h5 class="m-0 font-weight-bold text-white">
        <i class="fas fa-book mr-2"></i>
        Savings Ledger
      </h5>

      <button type="button" id="btnLedgerAdd" class="btn btn-add">
        <i class="fas fa-plus mr-1"></i>
        New Transaction
      </button>
    </div>

    <div class="card-body">
      <div class="table-responsive">
        <table id="savingsLedgerTable" class="table table-hover mb-0">
          <thead>
            <tr>
              <th>Reference No.</th>
              <th>Member ID</th>
              <th>Transaction Type</th>
              <th>Amount</th>
              <th>Balance After</th>
              <th>Description</th>
              <th>Created By</th>
              <th>Created Date</th>
              <th class="text-center">Action</th>
            </tr>
          </thead>

          <tbody id="ledgerTable">
            <tr>
              <td colspan="9" class="text-center text-muted">
                Loading savings ledger...
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- ==========================================================
     SAVINGS LEDGER MODAL
========================================================== -->

<div
  class="modal fade"
  id="ledgerModal"
  tabindex="-1"
  aria-labelledby="ledgerModalLabel"
  aria-hidden="true"
>
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <form id="ledgerForm" novalidate>
        <div class="modal-header">
          <h5 class="modal-title" id="ledgerModalLabel">
            <i class="fas fa-book mr-2"></i>
            New Transaction
          </h5>

          <button
            type="button"
            class="close"
            data-dismiss="modal"
            aria-label="Close"
          >
            <span aria-hidden="true">&times;</span>
          </button>
        </div>

        <div class="modal-body">
          <input type="hidden" id="LedgerID" name="ledgerId" />

          <!-- Member Savings -->

          <div class="form-group">
            <label for="SavingsID">
              Member Savings
              <span class="text-danger"></span>
            </label>

            <select
              id="SavingsID"
              name="savingsId"
              class="form-control"
              required
            >
              <option value="">Select Member Savings</option>
            </select>

            <div class="invalid-feedback">
              Please select a member savings account.
            </div>
          </div>

          <div class="form-row">
            <div class="form-group col-md-6">
              <label for="TransactionType">
                Transaction Type
                <span class="text-danger"></span>
              </label>

              <select
                id="TransactionType"
                name="transactionType"
                class="form-control"
                required
              >
                <option value="">Select Transaction Type</option>
                <option value="DEPOSIT">Deposit</option>
                <option value="WITHDRAWAL">Withdrawal</option>
                <option value="INTEREST_PAYOUT">Interest Payout</option>
                <option value="PENALTY">Penalty</option>
                <option value="ADJUSTMENT">Adjustment</option>
                <option value="TRANSFER">Transfer</option>
              </select>

              <div class="invalid-feedback">
                Please select a transaction type.
              </div>
            </div>

            <div class="form-group col-md-6">
              <label for="Amount">
                Amount
                <span class="text-danger"></span>
              </label>

              <input
                type="number"
                id="Amount"
                name="amount"
                class="form-control"
                placeholder="Enter transaction amount"
                min="0.01"
                step="0.01"
                required
              />

              <div class="invalid-feedback">
                Enter a valid amount greater than zero.
              </div>
            </div>
          </div>

          <!-- Edit Only -->

          <div class="form-row" id="autoFields" style="display: none">
            <div class="form-group col-md-6">
              <label for="ReferenceNo">Reference No.</label>

              <input
                type="text"
                id="ReferenceNo"
                class="form-control"
                readonly
              />
            </div>

            <div class="form-group col-md-6">
              <label for="BalanceAfter">Balance After</label>

              <input
                type="text"
                id="BalanceAfter"
                class="form-control"
                readonly
              />
            </div>
          </div>

          <div class="form-group mb-0">
            <label for="Description">Description</label>

            <textarea
              id="Description"
              name="description"
              class="form-control"
              rows="4"
              maxlength="1000"
              placeholder="Enter description (optional)"
            ></textarea>

            <div class="invalid-feedback">
              Description cannot exceed 1,000 characters.
            </div>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-cancel" data-dismiss="modal">
            Cancel
          </button>

          <button type="submit" class="btn btn-save" id="btnSave">
            <i class="fas fa-save mr-1"></i>
            Save Transaction
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
