<div class="container-fluid">
  <div class="custom-card shadow">
    <!-- Header -->
    <div class="custom-header">
      <div class="header-title">
        <i class="fas fa-book"></i>
        <span>Savings Ledger</span>
      </div>

      <button id="btnAdd" type="button" class="btn btn-add">
        <i class="fas fa-plus"></i>
        New Transaction
      </button>
    </div>

    <!-- Body -->
    <div class="custom-body">
      <div class="table-responsive">
        <table class="table custom-table mb-0" id="dataTable">
          <thead>
            <tr>
              <th>Reference No.</th>
              <th>Member</th>
              <th>Transaction</th>
              <th>Amount</th>
              <th>Balance After</th>
              <th>Description</th>
              <th>Created By</th>
              <th>Date</th>
              <th width="120">Action</th>
            </tr>
          </thead>

          <tbody id="ledgerTable"></tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Modal -->
<div
  class="modal fade"
  id="ledgerModal"
  tabindex="-1"
  role="dialog"
  aria-labelledby="ledgerModalLabel"
  aria-hidden="true"
>
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <form id="ledgerForm">
        <div class="modal-header">
          <h5 class="modal-title" id="ledgerModalLabel">New Transaction</h5>

          <button
            type="button"
            class="close"
            data-dismiss="modal"
            aria-label="Close"
          >
            <span aria-hidden="true">&times;</span>
          </button>
        </div>

        <div class="modal-body">
          <input type="hidden" id="LedgerID" name="LedgerID" />

          <div class="form-group">
            <label for="SavingsID">Member</label>

            <select
              id="SavingsID"
              name="SavingsID"
              class="form-control"
              required
            ></select>
          </div>

          <div class="form-group">
            <label for="TransactionType">Transaction</label>

            <select
              id="TransactionType"
              name="TransactionType"
              class="form-control"
              required
            ></select>
          </div>

          <div class="form-group">
            <label for="Amount">Amount</label>

            <input
              type="number"
              id="Amount"
              name="Amount"
              class="form-control"
              min="0.01"
              step="0.01"
              required
            />
          </div>

          <div class="form-group mb-0">
            <label for="Description">Description</label>

            <textarea
              id="Description"
              name="Description"
              class="form-control"
              rows="4"
            ></textarea>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-dismiss="modal">
            Cancel
          </button>

          <button type="submit" class="btn btn-save">Save</button>
        </div>
      </form>
    </div>
  </div>
</div>
