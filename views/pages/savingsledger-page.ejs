<div class="container-fluid">
  <div class="card shadow mb-4 savings-ledger-table">
    <!-- Header -->
    <div class="card-header d-flex justify-content-between align-items-center">
      <h5 class="m-0 font-weight-bold text-white">
        <i class="fas fa-book mr-2"></i>
        Savings Ledger
      </h5>

      <button type="button" id="btnAdd" class="btn btn-add">
        <i class="fas fa-plus mr-1"></i>
        New Transaction
      </button>
    </div>

    <!-- Body -->
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-hover mb-0" id="dataTable">
          <thead>
            <tr>
              <th>Reference No.</th>
              <th>Member</th>
              <th>Transaction</th>
              <th>Amount</th>
              <th>Balance After</th>
              <th>Description</th>
              <th>Created By</th>
              <th>Date</th>
              <th width="140" class="text-center">Action</th>
            </tr>
          </thead>

          <tbody id="ledgerTable"></tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- ==========================================================
     SAVINGS LEDGER MODAL
========================================================== -->

<div
  class="modal fade"
  id="ledgerModal"
  tabindex="-1"
  aria-labelledby="ledgerModalLabel"
  aria-hidden="true"
>
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <form id="ledgerForm" novalidate>
        <div class="modal-header">
          <h5 class="modal-title" id="ledgerModalLabel">
            <i class="fas fa-book mr-2"></i>
            New Transaction
          </h5>

          <button
            type="button"
            class="close"
            data-dismiss="modal"
            aria-label="Close"
          >
            <span aria-hidden="true">&times;</span>
          </button>
        </div>

        <div class="modal-body">
          <input type="hidden" id="LedgerID" name="LedgerID" />

          <div class="form-group">
            <label for="SavingsID">
              Member <span class="text-danger"></span>
            </label>

            <select
              id="SavingsID"
              name="SavingsID"
              class="form-control"
              required
            ></select>

            <div class="invalid-feedback">Member is required.</div>
          </div>

          <div class="form-group">
            <label for="TransactionType">
              Transaction Type <span class="text-danger"></span>
            </label>

            <select
              id="TransactionType"
              name="TransactionType"
              class="form-control"
              required
            ></select>

            <div class="invalid-feedback">Transaction type is required.</div>
          </div>

          <div class="form-group">
            <label for="Amount">
              Amount <span class="text-danger"></span>
            </label>

            <input
              type="number"
              id="Amount"
              name="Amount"
              class="form-control"
              placeholder="Enter amount"
              min="0.01"
              step="0.01"
              required
            />

            <div class="invalid-feedback">Amount is required.</div>
          </div>

          <div class="form-group mb-0">
            <label for="Description"> Description </label>

            <textarea
              id="Description"
              name="Description"
              class="form-control"
              rows="4"
              placeholder="Enter description (optional)"
            ></textarea>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-cancel" data-dismiss="modal">
            Cancel
          </button>

          <button type="submit" class="btn btn-save" id="btnSave">
            <i class="fas fa-save mr-1"></i>
            Save
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
