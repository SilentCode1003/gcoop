<div class="theme-toggle">
  <button type="button" id="themeBtn" aria-label="Toggle Theme">
    <i class="fas fa-moon"></i>
  </button>
</div>

<div class="login-container">
  <div class="login-header">
    <img
      src="/images/logo.png"
      alt="Solutions Supply & Allied Services Corp."
      class="login-logo"
    />

    <h2>Welcome Back!</h2>

    <p>Login to continue to your account</p>
  </div>

  <form id="loginForm">
    <!-- Username -->
    <div class="input-group">
      <label for="username">Username</label>

      <input
        autocomplete="off"
        type="text"
        id="username"
        name="username"
        placeholder="Enter your username"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        required
      />
    </div>

    <!-- Password -->
    <div class="input-group">
      <label for="password">Password</label>

      <div class="password-wrapper">
        <input
          autocomplete="off"
          type="password"
          id="password"
          name="password"
          placeholder="Enter your password"
          autocomplete="new-password"
          required
        />

        <span
          id="togglePassword"
          role="button"
          tabindex="0"
          aria-label="Show Password"
        >
          <i class="fas fa-eye"></i>
        </span>
      </div>
    </div>

    <!-- Login Button -->
    <button type="submit" id="loginBtn" class="login-btn">
      <i class="fas fa-sign-in-alt"></i>
      Login
    </button>
  </form>
</div>
