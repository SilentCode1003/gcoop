<div class="container-fluid">
  <div class="card shadow mb-4 savings-ledger-table member-savings-table">
    <div class="card-header d-flex justify-content-between align-items-center">
      <h5 class="m-0 font-weight-bold text-white">
        <i class="fas fa-piggy-bank mr-2"></i>
        Member Savings
      </h5>

      <button type="button" id="btnAdd" class="btn btn-add">
        <i class="fas fa-plus mr-1"></i>
        New Savings Account
      </button>
    </div>

    <div class="card-body">
      <div class="table-responsive">
        <table
          id="memberSavingsTable"
          class="table table-bordered table-hover mb-0"
          width="100%"
          cellspacing="0"
        >
          <thead>
            <tr>
              <th>Member ID</th>
              <th>Member Name</th>
              <th>Current Balance</th>
              <th>Transactions</th>
              <th>Last Updated</th>
              <th class="text-center">Action</th>
            </tr>
          </thead>

          <tbody id="savingsTable">
            <tr>
              <td colspan="6" class="text-center text-muted">
                Loading member savings...
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- MEMBER SAVINGS MODAL -->
<div
  class="modal fade"
  id="savingsModal"
  tabindex="-1"
  role="dialog"
  aria-labelledby="savingsModalLabel"
  aria-hidden="true"
>
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content">
      <form id="savingsForm" novalidate>
        <div class="modal-header">
          <h5 class="modal-title" id="savingsModalLabel">
            <i class="fas fa-plus mr-2"></i>
            New Savings Account
          </h5>

          <button
            type="button"
            class="close"
            data-dismiss="modal"
            aria-label="Close"
          >
            <span aria-hidden="true">&times;</span>
          </button>
        </div>

        <div class="modal-body">
          <!-- member_savings.ms_id (UUID) -->
          <input type="hidden" id="SavingsRecordID" value="" />

          <div class="form-group">
            <label for="MemberID">
              Member <span class="text-danger">*</span>
            </label>

            <select id="MemberID" class="form-control" required>
              <option value="">Select Member</option>
            </select>

            <div class="invalid-feedback">Please select a member.</div>
          </div>

          <div class="form-group mb-0">
            <label for="Balance" id="BalanceLabel">
              Opening Balance <span class="text-danger">*</span>
            </label>

            <input
              type="number"
              id="Balance"
              class="form-control"
              placeholder="0.00"
              min="0"
              step="0.01"
              inputmode="decimal"
              value="0"
              required
            />

            <div class="invalid-feedback">
              Enter a valid balance (zero or greater).
            </div>

            <small class="form-text text-muted" id="BalanceHint">
              An opening balance above zero is also recorded as a deposit in the
              Savings Ledger.
            </small>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-cancel" data-dismiss="modal">
            Cancel
          </button>

          <button type="submit" class="btn btn-save" id="btnSave">
            <i class="fas fa-save mr-1"></i>
            Save Account
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
