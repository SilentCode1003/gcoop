<div class="container-fluid">
  <!-- Dashboard Header -->
  <div
    class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-4"
  >
    <h3 class="dashboard-title mb-3 mb-md-0">
      <i class="fas fa-chart-line mr-2"></i>
      Dashboard
    </h3>

    <button type="button" id="btnRefresh" class="btn btn-refresh shadow-sm">
      <i class="fas fa-sync-alt mr-2"></i>
      Refresh Dashboard
    </button>
  </div>

  <!-- Statistics -->
  <div class="row">
    <!-- Members -->
    <div class="col-xl-3 col-md-6 mb-4">
      <div
        class="card dashboard-card card-danger h-100"
        role="button"
        tabindex="0"
        onclick="window.location.href = '/members'"
        onkeypress="
          if (event.key === 'Enter') {
            window.location.href = '/members';
          }
        "
      >
        <div class="card-body">
          <div class="row no-gutters align-items-center">
            <div class="col">
              <div class="card-label members">Members</div>

              <h2 id="totalMembers">0</h2>
            </div>

            <div class="col-auto">
              <i class="fas fa-users dashboard-icon members"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Users -->
    <div class="col-xl-3 col-md-6 mb-4">
      <div
        class="card dashboard-card card-primary h-100"
        role="button"
        tabindex="0"
        onclick="window.location.href = '/users'"
        onkeypress="
          if (event.key === 'Enter') {
            window.location.href = '/users';
          }
        "
      >
        <div class="card-body">
          <div class="row no-gutters align-items-center">
            <div class="col">
              <div class="card-label users">Users</div>

              <h2 id="totalUsers">0</h2>
            </div>

            <div class="col-auto">
              <i class="fas fa-user-shield dashboard-icon users"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Loan Rates -->
    <div class="col-xl-3 col-md-6 mb-4">
      <div
        class="card dashboard-card card-success h-100"
        role="button"
        tabindex="0"
        onclick="window.location.href = '/loan-rates'"
        onkeypress="
          if (event.key === 'Enter') {
            window.location.href = '/loan-rates';
          }
        "
      >
        <div class="card-body">
          <div class="row no-gutters align-items-center">
            <div class="col">
              <div class="card-label loans">Loan Rates</div>

              <h2 id="totalLoanRates">0</h2>
            </div>

            <div class="col-auto">
              <i class="fas fa-percent dashboard-icon loans"></i>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Denominations -->
    <div class="col-xl-3 col-md-6 mb-4">
      <div
        class="card dashboard-card card-warning h-100"
        role="button"
        tabindex="0"
        onclick="window.location.href = '/denominations'"
        onkeypress="
          if (event.key === 'Enter') {
            window.location.href = '/denominations';
          }
        "
      >
        <div class="card-body">
          <div class="row no-gutters align-items-center">
            <div class="col">
              <div class="card-label denomination">Denominations</div>

              <h2 id="totalDenomination">0</h2>
            </div>

            <div class="col-auto">
              <i class="fas fa-money-bill-wave dashboard-icon denomination"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Recent Members -->
  <div class="card dashboard-table glass-card shadow mb-4">
    <div class="card-header glass-header">
      <h5 class="m-0 font-weight-bold">
        <i class="fas fa-users mr-2"></i>

        Recent Members
      </h5>
    </div>

    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-hover mb-0" id="dataTable">
          <thead>
            <tr>
              <th>Employee ID</th>

              <th>Full Name</th>

              <th>Contact</th>

              <th>Registered Date</th>
            </tr>
          </thead>

          <tbody id="recentMembers"></tbody>
        </table>
      </div>
    </div>
  </div>
</div>
