<div class="container-fluid">

    <!-- Page Heading -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="dashboard-title">Dashboard</h1>

        <button class="btn btn-refresh btn-sm shadow-sm" id="btnRefresh">
            <i class="fas fa-sync-alt fa-sm"></i>
            Refresh
        </button>
    </div>

    <!-- Statistics -->
    <div class="row">

        <!-- Members -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card dashboard-card border-left-danger shadow h-100 py-2">
                <div class="card-body">

                    <div class="row no-gutters align-items-center">

                        <div class="col mr-2">

                            <div class="text-xs font-weight-bold members-title text-uppercase mb-1">
                                Members
                            </div>

                            <h2 id="totalMembers">0</h2>

                        </div>

                        <div class="col-auto">
                            <i class="fas fa-users"></i>
                        </div>

                    </div>

                </div>
            </div>
        </div>

        <!-- Users -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card dashboard-card border-left-primary shadow h-100 py-2">
                <div class="card-body">

                    <div class="row no-gutters align-items-center">

                        <div class="col mr-2">

                            <div class="text-xs font-weight-bold users-title text-uppercase mb-1">
                                Users
                            </div>

                            <h2 id="totalUsers">0</h2>

                        </div>

                        <div class="col-auto">
                            <i class="fas fa-user-shield"></i>
                        </div>

                    </div>

                </div>
            </div>
        </div>

        <!-- Loan Rates -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card dashboard-card border-left-success shadow h-100 py-2">
                <div class="card-body">

                    <div class="row no-gutters align-items-center">

                        <div class="col mr-2">

                            <div class="text-xs font-weight-bold loan-title text-uppercase mb-1">
                                Loan Rates
                            </div>

                            <h2 id="totalLoanRates">0</h2>

                        </div>

                        <div class="col-auto">
                            <i class="fas fa-percent"></i>
                        </div>

                    </div>

                </div>
            </div>
        </div>

        <!-- Denominations -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card dashboard-card border-left-warning shadow h-100 py-2">
                <div class="card-body">

                    <div class="row no-gutters align-items-center">

                        <div class="col mr-2">

                            <div class="text-xs font-weight-bold denom-title text-uppercase mb-1">
                                Denominations
                            </div>

                            <h2 id="totalDenomination">0</h2>

                        </div>

                        <div class="col-auto">
                            <i class="fas fa-money-bill-wave"></i>
                        </div>

                    </div>

                </div>
            </div>
        </div>

    </div>

    <!-- Recent Members -->
    <div class="card dashboard-table shadow mb-4">

        <div class="card-header">
            <h6 class="m-0 font-weight-bold">Recent Members</h6>
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover">

                    <thead>
                        <tr>
                            <th>Employee ID</th>
                            <th>Full Name</th>
                            <th>Contact</th>
                            <th>Registered Date</th>
                        </tr>
                    </thead>

                    <tbody id="recentMembers"></tbody>

                </table>

            </div>

        </div>

    </div>

</div>