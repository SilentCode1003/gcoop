<div class="container-fluid">

    <!-- Page Header -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center mb-4">

        <h3 class="dashboard-title mb-3 mb-sm-0">
            <i class="fas fa-chart-line text-danger mr-2"></i>
            Dashboard
        </h3>

        <button
            type="button"
            id="btnRefresh"
            class="btn btn-refresh shadow-sm"
            aria-label="Refresh Dashboard">
            <i class="fas fa-sync-alt mr-2"></i>
            <span>Refresh Dashboard</span>
        </button>

    </div>

    <!-- Statistics -->
    <div class="row">

        <!-- Members -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card dashboard-card card-danger h-100 py-2"
                 role="button"
                 tabindex="0"
                 onclick="location.href='/members'"
                 onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();location.href='/members';}">

                <div class="card-body">
                    <div class="row no-gutters align-items-center">

                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">
                                Members
                            </div>

                            <h2 id="totalMembers" class="mb-0">0</h2>
                        </div>

                        <div class="col-auto">
                            <i class="fas fa-users fa-3x text-danger"></i>
                        </div>

                    </div>
                </div>

            </div>
        </div>

        <!-- Users -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card dashboard-card card-primary h-100 py-2"
                 role="button"
                 tabindex="0"
                 onclick="location.href='/users'"
                 onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();location.href='/users';}">

                <div class="card-body">
                    <div class="row no-gutters align-items-center">

                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                Users
                            </div>

                            <h2 id="totalUsers" class="mb-0">0</h2>
                        </div>

                        <div class="col-auto">
                            <i class="fas fa-user-shield fa-3x text-primary"></i>
                        </div>

                    </div>
                </div>

            </div>
        </div>

        <!-- Loan Rates -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card dashboard-card card-success h-100 py-2"
                 role="button"
                 tabindex="0"
                 onclick="location.href='/loan-rates'"
                 onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();location.href='/loan-rates';}">

                <div class="card-body">
                    <div class="row no-gutters align-items-center">

                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                Loan Rates
                            </div>

                            <h2 id="totalLoanRates" class="mb-0">0</h2>
                        </div>

                        <div class="col-auto">
                            <i class="fas fa-percent fa-3x text-success"></i>
                        </div>

                    </div>
                </div>

            </div>
        </div>

        <!-- Denominations -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card dashboard-card card-warning h-100 py-2"
                 role="button"
                 tabindex="0"
                 onclick="location.href='/denominations'"
                 onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();location.href='/denominations';}">

                <div class="card-body">
                    <div class="row no-gutters align-items-center">

                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                Denominations
                            </div>

                            <h2 id="totalDenomination" class="mb-0">0</h2>
                        </div>

                        <div class="col-auto">
                            <i class="fas fa-money-bill-wave fa-3x text-warning"></i>
                        </div>

                    </div>
                </div>

            </div>
        </div>

    </div>

    <!-- Recent Members -->
    <div class="card dashboard-table shadow mb-4">

        <div class="card-header bg-danger py-3">
            <h6 class="m-0 font-weight-bold text-white">
                <i class="fas fa-users mr-2"></i>
                Recent Members
            </h6>
        </div>

        <div class="card-body">
            <div class="table-responsive">

                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Employee ID</th>
                            <th>Full Name</th>
                            <th>Contact</th>
                            <th>Registered Date</th>
                        </tr>
                    </thead>

                    <tbody id="recentMembers"></tbody>
                </table>

            </div>
        </div>

    </div>

</div>