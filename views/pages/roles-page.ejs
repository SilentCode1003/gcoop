<div class="container-fluid">
  <div class="card roles-table shadow mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
      <h5 class="m-0 font-weight-bold text-white">
        <i class="fas fa-user-shield mr-2"></i>
        Roles &amp; Permissions
      </h5>

      <button type="button" id="btnAddRole" class="btn btn-add">
        <i class="fas fa-plus mr-1"></i>
        Add Role
      </button>
    </div>

    <div class="card-body">
      <!-- SELECT ROLE -->
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h6 class="rp-section-title m-0">
          <i class="fas fa-user-tag mr-2"></i>
          Select Role
        </h6>

        <div>
          <button
            type="button"
            id="btnEditRole"
            class="btn btn-secondary btn-sm"
            title="Rename selected role"
            disabled
          >
            <i class="fas fa-edit"></i>
          </button>

          <button
            type="button"
            id="btnDeleteRole"
            class="btn btn-danger btn-sm ml-2"
            title="Delete selected role"
            disabled
          >
            <i class="fas fa-trash"></i>
          </button>
        </div>
      </div>

      <div id="roleButtons" class="d-flex flex-wrap mb-4"></div>

      <!-- BULK PERMISSIONS -->
      <div
        class="d-flex justify-content-between align-items-center flex-wrap mb-3"
      >
        <h6 class="rp-section-title m-0">
          <i class="fas fa-shield-alt mr-2"></i>
          Permissions for:
          <span id="selectedRoleName">—</span>
        </h6>

        <div>
          <button
            type="button"
            id="btnResetAll"
            class="btn btn-cancel mr-2"
            disabled
          >
            <i class="fas fa-undo mr-1"></i>
            Reset All
          </button>

          <button type="button" id="btnUpdate" class="btn btn-save" disabled>
            <i class="fas fa-save mr-1"></i>
            Update Permissions (0)
          </button>
        </div>
      </div>

      <div class="row" id="moduleGrid"></div>
    </div>
  </div>
</div>

<!-- ==========================================================
     ROLE MODAL
========================================================== -->

<div
  class="modal fade"
  id="roleModal"
  tabindex="-1"
  aria-labelledby="modalTitle"
  aria-hidden="true"
>
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <form id="roleForm" novalidate>
        <div class="modal-header">
          <h5 class="modal-title" id="modalTitle">
            <i class="fas fa-user-tag mr-2"></i>
            Add Role
          </h5>

          <button
            type="button"
            class="close"
            data-dismiss="modal"
            aria-label="Close"
          >
            <span aria-hidden="true">&times;</span>
          </button>
        </div>

        <div class="modal-body">
          <input type="hidden" id="roleId" />

          <div class="form-group mb-0">
            <label for="roleName">
              Role Name
              <span class="text-danger">*</span>
            </label>

            <input
              type="text"
              class="form-control"
              id="roleName"
              name="roleName"
              placeholder="Enter role name"
              autocomplete="off"
              maxlength="300"
              required
            />

            <div class="invalid-feedback">Role name is required.</div>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-cancel" data-dismiss="modal">
            Cancel
          </button>

          <button type="submit" class="btn btn-save" id="btnSave">
            <i class="fas fa-save mr-1"></i>
            Save
          </button>
        </div>
      </form>
    </div>
  </div>
</div>