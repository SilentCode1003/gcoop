<div class="container-fluid">
  <div class="card shadow mb-4 dashboard-table">
    <div
      class="card-header py-3 d-flex justify-content-between align-items-center"
    >
      <h6 class="m-0 font-weight-bold text-white">
        <i class="fas fa-user-lock mr-2"></i>
        Permissions
      </h6>

      <button type="button" id="btnAdd" class="btn btn-add">
        <i class="fas fa-plus mr-1"></i>
        Add Permission
      </button>
    </div>

    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-hover mb-0" id="dataTable" width="100%">
          <thead>
            <tr>
              <th width="80">ID</th>
              <th>Role</th>
              <th>Route</th>
              <th>Permission</th>
              <th width="180">Created Date</th>
              <th width="180">Updated Date</th>
              <th width="140" class="text-center">Action</th>
            </tr>
          </thead>

          <tbody id="permissionTable"></tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- =========================================
     PERMISSION MODAL
========================================= -->

<!-- =========================================
     PERMISSION MODAL
========================================= -->

<div
  class="modal fade"
  id="permissionModal"
  tabindex="-1"
  role="dialog"
  aria-labelledby="modalTitle"
  aria-hidden="true"
>
  <div class="modal-dialog modal-lg">
    <div class="modal-content">

      <form id="permissionForm" novalidate>

        <div class="modal-header">
          <h5 class="modal-title" id="modalTitle">
            <i class="fas fa-user-lock mr-2"></i>
            Add Permission
          </h5>

          <button
            type="button"
            class="close"
            data-dismiss="modal">
            <span>&times;</span>
          </button>
        </div>

        <div class="modal-body">

          <input type="hidden" id="permissionId" />

          <!-- Role -->
          <div class="form-group">
            <label for="roleId">
              Role <span class="text-danger"></span>
            </label>

            <select
              class="form-control"
              id="roleId"
              required>
              <option value="">Select Role</option>
            </select>

            <div class="invalid-feedback">
              Please select a role.
            </div>
          </div>

          <!-- Route -->
          <div class="form-group">
            <label for="routeId">
              Route <span class="text-danger"></span>
            </label>

            <select
              class="form-control"
              id="routeId"
              required>
              <option value="">Select Route</option>
            </select>

            <div class="invalid-feedback">
              Please select a route.
            </div>
          </div>

          <!-- Permission -->
          <div class="form-group">
            <label for="permission">
              Permission <span class="text-danger"></span>
            </label>

            <select
              class="form-control"
              id="permission"
              required>
              <option value="">Select Permission</option>
              <option value="view">View</option>
              <option value="write">Write</option>
              <option value="all">All</option>
            </select>

            <div class="invalid-feedback">
              Please select a permission.
            </div>
          </div>

        </div>

        <div class="modal-footer">

          <button
            type="button"
            class="btn btn-cancel"
            data-dismiss="modal">
            Cancel
          </button>

          <button
            type="submit"
            class="btn btn-save"
            id="btnSave">
            <i class="fas fa-save mr-1"></i>
            Save
          </button>

        </div>

      </form>

    </div>
  </div>
</div>
     
