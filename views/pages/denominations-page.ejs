<div class="container-fluid">
  <!-- Denominations Card -->
  <div class="card denominations-card shadow mb-4">
    <div
      class="card-header denominations-header d-flex justify-content-between align-items-center"
    >
      <h5 class="m-0 font-weight-bold">
        <i class="fas fa-money-bill-wave mr-2"></i>
        Denominations
      </h5>

      <button type="button" id="btnAdd" class="btn btn-add-denomination">
        <i class="fas fa-plus mr-1"></i>
        Add Denomination
      </button>
    </div>

    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-hover mb-0" id="dataTable">
          <thead>
            <tr>
              <th width="80">ID</th>
              <th>Denomination Name</th>
              <th width="180">Value</th>
              <th width="180">Created Date</th>
              <th width="180">Updated Date</th>
              <th width="140" class="text-center">Action</th>
            </tr>
          </thead>

          <tbody id="denominationTable"></tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- ==========================
     DENOMINATION MODAL
========================== -->

<div
  class="modal fade"
  id="denominationModal"
  tabindex="-1"
  aria-labelledby="modalTitle"
  aria-hidden="true"
>
  <div class="modal-dialog">
    <div class="modal-content">
      <form id="denominationForm" novalidate>
        <div class="modal-header">
          <h5 class="modal-title" id="modalTitle">
            <i class="fas fa-money-bill-wave mr-2"></i>
            Add Denomination
          </h5>

          <button
            type="button"
            class="close"
            data-dismiss="modal"
            aria-label="Close"
          >
            <span aria-hidden="true">&times;</span>
          </button>
        </div>

        <div class="modal-body">
          <input type="hidden" id="denominationId" />

          <div class="form-group">
            <label for="denominationName">Denomination Name</label>

            <input
              type="text"
              class="form-control"
              id="denominationName"
              placeholder="Enter denomination name"
            />

            <div class="invalid-feedback">Denomination name is required.</div>
          </div>

          <div class="form-group">
            <label for="denominationValue">Value</label>

            <input
              type="number"
              class="form-control"
              id="denominationValue"
              placeholder="Enter denomination value"
            />

            <div class="invalid-feedback">Value is required.</div>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-cancel" data-dismiss="modal">
            Cancel
          </button>

          <button type="submit" class="btn btn-save" id="btnSave">
            <i class="fas fa-save mr-1"></i>
            Save
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
