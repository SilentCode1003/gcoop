<div class="container-fluid">
  <!-- Loan Rates Card -->
  <div class="card loan-rates-card shadow mb-4">
    <div
      class="card-header loan-rates-header d-flex justify-content-between align-items-center"
    >
      <h5 class="m-0 font-weight-bold">
        <i class="fas fa-percent mr-2"></i>
        Loan Rates
      </h5>

      <button type="button" id="btnAdd" class="btn btn-add-loan-rate">
        <i class="fas fa-plus mr-1"></i>
        Add Loan Rate
      </button>
    </div>

    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-hover mb-0" id="dataTable">
          <thead>
            <tr>
              <th width="80">ID</th>
              <th>Loan Name</th>
              <th width="150">Loan Rate (%)</th>
              <th width="180">Created Date</th>
              <th width="180">Updated Date</th>
              <th width="150" class="text-center">Action</th>
            </tr>
          </thead>

          <tbody id="loan-rateTable"></tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- ==========================
     LOAN RATE MODAL
========================== -->

<div
  class="modal fade"
  id="loanRateModal"
  tabindex="-1"
  aria-labelledby="modalTitle"
  aria-hidden="true"
>
  <div class="modal-dialog">
    <div class="modal-content">
      <form id="loan-rateForm" novalidate>
        <div class="modal-header">
          <h5 class="modal-title" id="modalTitle">
            <i class="fas fa-percent mr-2"></i>
            Add Loan Rate
          </h5>

          <button
            type="button"
            class="close"
            data-dismiss="modal"
            aria-label="Close"
          >
            <span aria-hidden="true">&times;</span>
          </button>
        </div>

        <div class="modal-body">
          <input type="hidden" id="loan-rateId" />

          <div class="form-group">
            <label for="loanName">Loan Name</label>

            <input
              type="text"
              class="form-control"
              id="loanName"
              placeholder="Enter loan name"
            />

            <div class="invalid-feedback">Loan name is required.</div>
          </div>

          <div class="form-group">
            <label for="loanRate">Loan Rate (%)</label>

            <input
              type="number"
              class="form-control"
              id="loanRate"
              step="0.01"
              min="0"
              placeholder="Example: 2.50"
            />

            <div class="invalid-feedback">Loan rate is required.</div>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-cancel" data-dismiss="modal">
            Cancel
          </button>

          <button type="submit" class="btn btn-save" id="btnSave">
            <i class="fas fa-save mr-1"></i>
            Save
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
