<div class="container-fluid">
  <div class="card shadow mb-4">
    <div
      class="card-header py-3 d-flex justify-content-between align-items-center"
    >
      <h5 class="m-0 font-weight-bold text-white">Routes</h5>

      <button type="button" class="btn btn-primary btn-sm" id="btnAdd">
        <i class="fas fa-plus mr-1"></i>
        Add Route
      </button>
    </div>

    <div class="card-body">
      <div class="table-responsive">
        <table
          class="table table-bordered table-hover"
          id="dataTable"
          width="100%"
        >
          <thead>
            <tr>
              <th width="80">ID</th>
              <th>Route Name</th>
              <th width="180">Created Date</th>
              <th width="180">Updated Date</th>
              <th width="160">Action</th>
            </tr>
          </thead>

          <tbody id="routesTable"></tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- ===========================
     ROUTE MODAL
============================ -->

<div
  class="modal fade"
  id="routesModal"
  tabindex="-1"
  role="dialog"
  aria-hidden="true"
>
  <div class="modal-dialog">
    <div class="modal-content">
      <form id="routesForm">
        <div class="modal-header">
          <h5 class="modal-title" id="modalTitle">Add Route</h5>

          <button type="button" class="close" data-dismiss="modal">
            <span>&times;</span>
          </button>
        </div>

        <div class="modal-body">
          <input type="hidden" id="routeId" />

          <div class="form-group">
            <label for="routeName"> Route Name </label>

            <input
              type="text"
              class="form-control"
              id="routeName"
              placeholder="Enter route name"
            />

            <div class="invalid-feedback">Route name is required.</div>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-dismiss="modal">
            Cancel
          </button>

          <button type="submit" class="btn btn-primary" id="btnSave">
            Save
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
