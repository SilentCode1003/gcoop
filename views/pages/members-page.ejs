<div class="container-fluid">
  <!-- Members Card -->
  <div class="card members-card shadow mb-4">
    <div
      class="card-header members-header d-flex justify-content-between align-items-center"
    >
      <h5 class="m-0 font-weight-bold">
        <i class="fas fa-users mr-2"></i>
        Members
      </h5>

      <button type="button" id="btnAdd" class="btn btn-add">
        <i class="fas fa-plus mr-1"></i>
        Add Member
      </button>
    </div>

    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-hover mb-0" id="dataTable">
          <thead>
            <tr>
              <th>Employee ID</th>
              <th>Full Name</th>
              <th>Address</th>
              <th>Contact</th>
              <th>Registered Date</th>
              <th>Registered By</th>
              <th class="text-center" width="140">Action</th>
            </tr>
          </thead>

          <tbody id="memberTable"></tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- ==========================
     MEMBER MODAL
========================== -->

<div
  class="modal fade"
  id="memberModal"
  tabindex="-1"
  aria-labelledby="modalTitle"
  aria-hidden="true"
>
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <form id="memberForm" novalidate>
        <div class="modal-header">
          <h5 class="modal-title" id="modalTitle">
            <i class="fas fa-user-plus mr-2"></i>
            Add Member
          </h5>

          <button
            type="button"
            class="close"
            data-dismiss="modal"
            aria-label="Close"
          >
            <span aria-hidden="true">&times;</span>
          </button>
        </div>

        <div class="modal-body">
          <input type="hidden" id="memberId" />

          <!-- Employee ID -->
          <div class="form-group">
            <label for="employeeId">
              Employee ID <span class="text-danger"></span>
            </label>
            <input
              type="text"
              class="form-control"
              id="employeeId"
              placeholder="Enter employee ID"
              autocomplete="off"
              required
            />
            <div class="invalid-feedback">Employee ID is required.</div>
          </div>

          <!-- Full Name -->
          <div class="form-group">
            <label for="fullName">
              Full Name <span class="text-danger"></span>
            </label>
            <input
              type="text"
              class="form-control"
              id="fullName"
              placeholder="Enter full name"
              autocomplete="off"
              required
            />
            <div class="invalid-feedback">Full name is required.</div>
          </div>

          <!-- Contact No. -->
          <div class="form-group">
            <label for="contact">
              Contact No. <span class="text-danger"></span>
            </label>
            <input
              type="text"
              class="form-control"
              id="contact"
              placeholder="09XXXXXXXXX"
              autocomplete="off"
              inputmode="numeric"
              maxlength="11"
              pattern="09[0-9]{9}"
              oninput="this.value = this.value.replace(/[^0-9]/g, '')"
              required
            />
            <div class="invalid-feedback">
              Please enter a valid 11-digit contact number.
            </div>
          </div>

          <!-- Address -->
          <div class="form-group">
            <label for="address">
              Address <span class="text-danger"></span>
            </label>
            <textarea
              class="form-control"
              id="address"
              rows="3"
              placeholder="Enter address"
              required
            ></textarea>
            <div class="invalid-feedback">Address is required.</div>
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-cancel" data-dismiss="modal">
            Cancel
          </button>

          <button type="submit" class="btn btn-save" id="btnSave">
            <i class="fas fa-save mr-1"></i>
            Save
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
